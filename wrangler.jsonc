{
  "name": "jacobc-official-website",
  "compatibility_date": "2026-02-15",
  "main": "dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "jacobc-official-website-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "jacobc-official-website",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
