---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionBand from '../components/SectionBand.astro';
import ServicesHeroVisual from '../components/ServicesHeroVisual.astro';
import { getCollection } from 'astro:content';

const serviceList = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);

const contactTypeMap: Record<string, string> = {
  'tender-management': 'tender',
  'iso-sheq-compliance': 'iso',
  'project-management': 'project',
  'web-development': 'website',
};

const engagementModels = [
  {
    kicker: '01 · FOR EMPLOYERS & CONTRACTORS',
    title: 'Full-Time / Executive Leadership',
    badge: 'Primary Focus',
    accent: true,
    description:
      'Available for Senior Tender Manager & Operations roles in Centurion / Gauteng where one leader owns bid acquisition, ISO 9001/14001/45001 compliance, project execution as needed, and SAP/Sage contract billing.',
    ctaLabel: 'Discuss a leadership role →',
    ctaHref: '/contact?type=employment',
  },
  {
    kicker: '02 · FOR BIDDING SMEs & JVs',
    title: 'Tender Compilation & ISO Readiness',
    badge: 'Per-Bid or Retainer',
    accent: true,
    description:
      'Freelance end-to-end tender preparation (RFP compliance matrix, SBD forms, CSD/CIDB verification, rate schedules) and practical ISO/SHEQ safety & quality packs for municipal and corporate bids.',
    ctaLabel: 'Book tender consultation →',
    ctaHref: '/contact?type=tender',
  },
  {
    kicker: '03 · COMPLEMENTARY DIGITAL BUILDS',
    title: 'Contractor Websites & Client Portals',
    badge: '2-Week Sprint',
    accent: false,
    description:
      'High-speed Astro and Next.js corporate websites, capability statements, and client portals designed specifically to give civil, plant hire, and logistics companies institutional credibility.',
    ctaLabel: 'Scope a website build →',
    ctaHref: '/contact?type=website',
  },
];

const faqs = [
  {
    q: 'What makes your approach as a Tender Manager different?',
    a: 'Most tender administrators only compile paperwork and hand over after submission. Because I also serve as appointed ISO 9001/14001/45001 Management Representative, run awarded projects when needed, and manage project billing in SAP and Sage, I price and structure bids that are operationally deliverable and profitable from day one.',
  },
  {
    q: 'Do you sign NDAs when assisting with freelance tender preparation and pricing?',
    a: 'Yes. Every tender consultation, rate schedule, and statutory compliance pack is handled under strict confidentiality, and I never prepare competing submissions for the same tender line item without explicit disclosure.',
  },
  {
    q: 'Which industries and tender types do you specialize in?',
    a: 'My strongest track record is in municipal and public-sector procurement (City of Tshwane, Gauteng municipalities, and SOEs) as well as commercial contracts across plant and equipment hire, fleet logistics, mobile water tankers, chemical sanitation, civil infrastructure, and horticultural maintenance.',
  },
  {
    q: 'How does your web development work fit alongside your tender management career?',
    a: 'Software and web engineering is my complementary technical edge. Through Playhouse Media Group, I built TenderTrack360 to modernize bid tracking and build fast Astro/Next.js websites for contractors who need a credible digital presence when bidding for corporate and municipal work.',
  },
];
---

<Layout
  title="Capabilities & Services | Tender Manager, ISO Lead & Project Billing"
  description="Core capabilities of Jacob Chademwiri: end-to-end tender management, ISO 9001/14001/45001 implementation, project delivery & SAP/Sage billing governance, and complementary contractor web development."
  active="services"
  schema="service"
  keywords={[
    'tender management',
    'bid compilation',
    'RFP review',
    'ISO 9001 14001 45001 implementation',
    'project billing SAP Sage',
    'AR management',
    'contractor website development',
    'Centurion',
    'Gauteng',
  ]}
>
  <div class="grid gap-10 px-5 pb-14 pt-16 sm:px-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:px-14 md:pt-20">
    <div>
      <p class="kicker">Capabilities &amp; Consulting</p>
      <h1 class="display mt-4 max-w-[19ch]">
        Winning the tender is step one. Running and billing it completes the job.
      </h1>
      <p class="mt-5 max-w-[580px] text-body-lg text-text-2">
        My primary discipline is <strong>Tender Management</strong>—backed by hands-on leadership across <strong>ISO 9001, 14001 &amp; 45001</strong> compliance, post-award project execution, and <strong>SAP &amp; Sage</strong> accounts receivable governance, plus complementary web and bid-tech engineering.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact?type=employment" class="btn btn-primary">Discuss a role or tender →</a>
        <a href="#tender-management" class="btn btn-secondary">Explore the 4 pillars</a>
      </div>
      <p class="mt-7 flex items-baseline gap-2.5 text-meta text-text-3">
        <span class="dot" aria-hidden="true"></span>
        Available for full-time Tender &amp; Operations leadership in Gauteng &amp; scoped consulting engagements.
      </p>
    </div>
    <ServicesHeroVisual />
  </div>

  <!-- 4 Ordered Capability Rows -->
  {
    serviceList.map((service, index) => {
      const contactType = contactTypeMap[service.id] ?? 'tender';
      return (
        <div
          id={service.id}
          class:list={[
            'grid gap-8 border-t border-divider px-5 py-10 sm:px-8 md:grid-cols-[minmax(0,320px)_minmax(0,1fr)] md:gap-10 md:px-14',
            index === serviceList.length - 1 && 'border-b',
          ]}
        >
          <div>
            <p class="data mb-2 text-meta font-medium text-accent">
              {service.data.number} · {service.id === 'web-development' ? 'Complementary Edge' : 'Core Discipline'}
            </p>
            <h2 class="h2">
              <a href={`/services/${service.id}`} class="hover:text-accent transition-colors">
                {service.data.title}
              </a>
            </h2>
          </div>
          <div>
            <p class="service-description mb-5">
              {service.data.summary}
            </p>
            <div class="flex flex-wrap gap-2">
              {service.data.tags.map((tag) => (
                <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-5">
              <a
                href={`/services/${service.id}`}
                class="inline-flex items-center gap-1.5 text-meta font-medium text-accent hover:underline"
              >
                <span>Explore methodology &amp; deliverables</span>
                <span aria-hidden="true">→</span>
              </a>
              <a
                href={`/contact?type=${contactType}`}
                class="inline-flex items-center gap-1.5 text-meta text-text-2 hover:text-accent"
              >
                <span>Enquire about {service.data.shortTitle}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      );
    })
  }

  <!-- Engagement Models -->
  <SectionBand id="engagement-models" glow="top-right">
    <div class="mb-7">
      <p class="kicker">How to Engage</p>
      <h2 class="h2 mt-4 max-w-[28ch]">Three ways to work together</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        engagementModels.map((model) => (
          <div class="card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <p class="card-kicker">{model.kicker}</p>
                <span class:list={['tag text-[11px] py-0.5 px-2 font-mono', model.accent ? 'tag-accent' : 'tag-neutral']}>
                  {model.badge}
                </span>
              </div>
              <h3 class="h3 mb-2.5">{model.title}</h3>
              <p class="card-body">{model.description}</p>
            </div>
            <div class="mt-5 border-t border-divider/40 pt-3.5">
              <a href={model.ctaHref} class="text-accent text-[13px] font-medium inline-flex items-center gap-1 hover:underline">
                <span>{model.ctaLabel}</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </SectionBand>

  <!-- Buyer & Employer FAQ -->
  <div id="faq" class="px-5 py-16 sm:px-8 md:px-14">
    <div class="mb-8">
      <p class="kicker">Questions &amp; Answers</p>
      <h2 class="h2 mt-4 max-w-[28ch]">Common questions from employers &amp; clients</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        faqs.map((item) => (
          <div class="card">
            <h3 class="card-title mb-2 text-text">{item.q}</h3>
            <p class="card-body">{item.a}</p>
          </div>
        ))
      }
    </div>
  </div>

  <ContactBand secondaryHref="/portfolio" secondaryLabel="See awarded contracts & work" />
</Layout>
