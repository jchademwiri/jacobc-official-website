---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import ServicesHeroVisual from '../components/ServicesHeroVisual.astro';

const rows = [
  {
    id: 'tender-management',
    number: '01',
    title: 'Full Tender Preparation Lifecycle',
    description:
      'Freelance and consulting tender management: opportunity identification, rigorous RFP/bid document analysis, compliance scheduling, CIDB alignments, CSD validations, and crafting compelling, competitive submissions that win government and corporate bids.',
    tags: [
      { label: 'RFP & Bid Review', accent: true },
      { label: 'Tender Lifecycle', accent: true },
      { label: 'Compliance Scheduling', accent: false },
      { label: 'CIDB & CSD', accent: false },
    ],
  },
  {
    id: 'web-development',
    number: '02',
    title: 'Custom Website Development',
    description:
      'Fast, accessible, and high-converting websites and web applications built in React, Next.js, Astro.js, and Tailwind CSS. Built with clean semantic code, first-class SEO, and ISO-standard quality discipline.',
    tags: [
      { label: 'Next.js & React', accent: true },
      { label: 'Astro.js', accent: true },
      { label: 'Tailwind CSS', accent: false },
      { label: 'Technical SEO', accent: false },
    ],
  },
  {
    id: 'project-management',
    number: '03',
    title: 'Project & Accounts Receivable Governance',
    description:
      'Operational project delivery coordination combined with financial governance: managing enterprise accounts receivable (billing integrity, credit control, cash-flow reconciliation in SAP and Sage), timeline tracking, and clean audit trails.',
    tags: [
      { label: 'AR Management', accent: true },
      { label: 'SAP & Sage', accent: true },
      { label: 'Project Coordination', accent: false },
      { label: 'Agile & M365', accent: false },
    ],
  },
  {
    id: 'iso-sheq-compliance',
    number: '04',
    title: 'ISO Standards & SHEQ Compliance in Practice',
    description:
      'Applying Integrated Management System (IMS) discipline across daily workflows: leveraging ISO 9001 (Quality), ISO 14001 (Environmental), and ISO 45001 (Health & Safety) standards for gap analysis, SOP formulation, HIRA registers, and audit readiness.',
    tags: [
      { label: 'ISO 9001 / 14001 / 45001', accent: true },
      { label: 'IMS Best Practices', accent: true },
      { label: 'SHEQ SOPs & HIRA', accent: false },
      { label: 'Audit Readiness', accent: false },
    ],
  },
];
---

<Layout
  title="Tender Preparation & Web Development Services"
  description="Full freelance tender lifecycle preparation, modern website development, and operational project & AR governance in Centurion, Gauteng. Guided by ISO standards."
  active="services"
  schema="service"
  keywords={['tender preparation', 'bid management', 'RFP review', 'website development', 'Next.js', 'Astro', 'AR management', 'SAP', 'Sage accounting', 'ISO 9001', 'SHEQ', 'Centurion', 'Gauteng']}
>
  <div class="grid gap-10 px-5 pb-14 pt-16 sm:px-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:px-14 md:pt-20">
    <div>
      <span class="kicker">Services &amp; Capabilities</span>
      <h1 class="display mt-4 max-w-[18ch]">
        Tender lifecycle, web development &amp; operational governance.
      </h1>
      <p class="mt-5 max-w-[560px] text-body-lg text-text-2">
        From winning competitive contracts and shipping robust digital platforms to managing enterprise accounts receivable and applying ISO quality standards every step of the way.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-primary">Start a project</a>
        <a href="#tender-management" class="btn btn-secondary">Explore disciplines</a>
      </div>
      <p class="mt-7 flex items-baseline gap-2.5 text-meta text-text-3">
        <span class="dot" aria-hidden="true"></span>
        Available for freelance tender submissions, web builds, and employment opportunities.
      </p>
    </div>
    <ServicesHeroVisual />
  </div>

  {
    rows.map((row, index) => (
      <div
        id={row.id}
        class:list={[
          'grid gap-8 border-t border-divider px-5 py-10 sm:px-8 md:grid-cols-[minmax(0,320px)_minmax(0,1fr)] md:gap-10 md:px-14',
          index === rows.length - 1 && 'border-b',
        ]}
      >
        <div>
          <p class="mb-2 text-[13px] font-medium text-accent">{row.number}</p>
          <h2 class="text-[26px]">{row.title}</h2>
        </div>
        <div>
          <p class="service-description mb-5">
            {row.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {row.tags.map((tag) => (
              <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
            ))}
          </div>
        </div>
      </div>
    ))
  }

  <ContactBand secondaryHref="/" secondaryLabel="Back to Home" />
</Layout>
