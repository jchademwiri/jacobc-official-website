---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionBand from '../components/SectionBand.astro';
import { PROFILE_PORTRAIT_URL } from '../lib/images';

const experience = [
  {
    date: 'Nov 2023 – Present (at STP since Jan 2022)',
    title: 'Tender & Project Manager | ISO Implementation Lead | AR Manager',
    meta: 'Sithembe Transportation & Projects · Full-time · Centurion, Gauteng',
    body: 'Leading full operational governance: Appointed Management Representative directing the Integrated Management System (IMS) implementation covering ISO 9001 (Quality), ISO 14001 (Environmental) and ISO 45001 (Health & Safety) for fleet, plant hire, and lifting machinery operations; managing high-value municipal tender acquisitions and enterprise accounts receivable (billing integrity, debt collection, and financial reconciliation via SAP and Sage).',
  },
  {
    date: 'Jan 2021 – Jan 2022',
    title: 'Tender & Office Administrator',
    meta: 'Babiya Geomatics and Trading · Full-time',
    body: 'Tender submissions and general office administration.',
  },
  {
    date: 'Jan 2020 – Present',
    title: 'Founder & Website Developer',
    meta: 'Playhouse Media Group · Founder · Gauteng, South Africa',
    body: 'Founded and grew Playhouse Media Group, building custom web solutions using React, Next.js and Astro.js.',
  },
];

const skills = [
  { label: 'Tender Management', accent: true },
  { label: 'Project Management', accent: true },
  { label: 'AR Manager (SAP & Sage)', accent: true },
  { label: 'Tender Preparation Lifecycle', accent: true },
  { label: 'ISO 9001 (Quality)', accent: true },
  { label: 'ISO 14001 (Environmental)', accent: true },
  { label: 'ISO 45001 (Health & Safety)', accent: true },
  { label: 'Integrated Management Systems (IMS)', accent: true },
  { label: 'SHEQ Management', accent: true },
  { label: 'SAP ERP / Sage Accounting', accent: true },
  { label: 'Next.js & React', accent: true },
  { label: 'Astro.js & TypeScript', accent: true },
  { label: 'HIRA & Risk Assessment', accent: false },
  { label: 'Compliance & Auditing', accent: false },
  { label: 'Invoicing & Credit Control', accent: false },
  { label: 'Tailwind CSS', accent: false },
  { label: 'Technical SEO', accent: false },
  { label: 'Figma', accent: false },
];
---

<Layout
  title="About Jacob Chademwiri | Tender & Project Specialist"
  description="Professional background of Jacob Chademwiri: tender management, enterprise AR governance (SAP & Sage), ISO implementation, and custom web development."
  image={PROFILE_PORTRAIT_URL}
  active="about"
  schema="person"
  keywords={['Jacob Chademwiri', 'tender management', 'project management', 'AR manager', 'SAP', 'Sage accounting', 'ISO 9001', 'ISO 14001', 'ISO 45001', 'SHEQ', 'web developer', 'Centurion', 'Gauteng']}
>
  <div class="grid gap-8 px-5 py-16 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:gap-12 md:px-14">
    <figure class="m-0">
      <img
        src={PROFILE_PORTRAIT_URL}
        alt="Jacob Chademwiri — Tender & Project Manager, ISO Implementation Lead, AR Manager, Web Developer"
        width="640"
        height="800"
        class="aspect-[4/5] w-full rounded-xl object-cover"
        loading="lazy"
      />
    </figure>
    <div>
      <p class="kicker">About</p>
      <h1 class="h1 mt-4 mb-5 max-w-[18ch]">
        Submitting tenders isn't the hard part. Understanding the compliance systems behind them is.
      </h1>
      <p class="mb-6 max-w-[52ch] text-body text-text-2">
        Based in Centurion, Gauteng, I bring deep hands-on expertise across tender acquisition, enterprise AR governance (SAP &amp; Sage), and web delivery — applying ISO quality frameworks to every operational system and digital platform. I serve as Tender &amp; Project Manager and AR Manager at Sithembe Transportation &amp; Projects, while building custom web applications through Playhouse Media Group.
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="tag tag-accent">Tender Management</span>
        <span class="tag tag-accent">Project Management</span>
        <span class="tag tag-accent">AR Governance (SAP &amp; Sage)</span>
        <span class="tag tag-accent">ISO Standards</span>
        <span class="tag tag-neutral">Web Development</span>
      </div>
    </div>
  </div>

  <div id="experience" class="px-5 pb-16 pt-6 sm:px-8 md:px-14">
    <h2 class="kicker">Experience</h2>
    <div class="mt-5 flex flex-col">
      {
        experience.map((role) => (
          <div class="border-b border-divider py-5">
            <p class="data mb-1.5 text-meta text-accent">{role.date}</p>
            <h3 class="card-title mb-1">{role.title}</h3>
            <p class="mb-2.5 text-meta text-text-3">{role.meta}</p>
            <p class="card-body max-w-[60ch]">{role.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <SectionBand id="skills" glow="top-right">
    <h2 class="kicker mb-5">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {
        skills.map((skill) => (
          <span class={skill.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{skill.label}</span>
        ))
      }
    </div>
  </SectionBand>

  <ContactBand headingLevel={2} glow="none" />
</Layout>
