---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';

const experience = [
  {
    date: 'Jan 2022 – Present',
    title: 'Tendering & Accounts Receivable Manager, Projects Coordinator',
    meta: 'Sithembe Transportation & Projects · Full-time · Centurion, Gauteng',
    body: 'Tender management, project coordination and administration, invoicing and website upkeep: financial accuracy and compliance across all projects.',
  },
  {
    date: 'Jan 2021 – Jan 2022',
    title: 'Tender & Office Administrator',
    meta: 'Babiya Geomatics and Trading · Full-time',
    body: 'Tender submissions and general office administration.',
  },
  {
    date: 'Jan 2020 – Present',
    title: 'Founder & Website Developer',
    meta: 'Playhouse Media Group · Founder · Gauteng, South Africa',
    body: 'Founded and grew Playhouse Media Group into a group of brands (Apex Web Solutions, Tender Edge Solutions and TenderTrack360), building custom web solutions using React, Next.js and Astro.js.',
  },
];

const skills = [
  { label: 'Tender Management', accent: true },
  { label: 'Project Management', accent: true },
  { label: 'Accounts Receivable Management', accent: true },
  { label: 'Stakeholder Management', accent: false },
  { label: 'Sage Accounting', accent: false },
  { label: 'Invoicing', accent: false },
  { label: 'Microsoft 365', accent: false },
  { label: 'React.js', accent: false },
  { label: 'Next.js', accent: false },
  { label: 'Astro.js', accent: false },
  { label: 'TypeScript', accent: false },
  { label: 'Tailwind CSS', accent: false },
  { label: 'SEO', accent: false },
  { label: 'Figma', accent: false },
];
---

<Layout
  title="About"
  description="Submitting tenders isn't the hard part. Understanding the compliance systems behind them is."
  active="about"
>
  <div class="grid gap-8 px-5 py-16 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:px-14 md:py-16">
    <figure class="m-0">
      <img
        src="https://picsum.photos/seed/jacob-portrait/640/800"
        alt="Placeholder portrait, to be replaced with a photo of Jacob Chademwiri"
        class="aspect-[4/5] w-full rounded-xl object-cover"
        loading="lazy"
      />
    </figure>
    <div>
      <span class="kicker">About</span>
      <h1 class="mb-4 max-w-[18ch] text-[32px] leading-[1.2] sm:text-[42px]">
        Submitting tenders isn't the hard part. Understanding the compliance systems behind them is.
      </h1>
      <p class="mb-6 max-w-[52ch] text-[15.5px] leading-[1.65]" style="color: color-mix(in srgb, var(--color-text) 78%, transparent)">
        Based in Centurion, Gauteng, I've spent years across tendering, ISO/SHEQ and web delivery, building the systems that back a bid and the sites that carry the brand behind it. I'm currently Tendering & Accounts Receivable Manager at Sithembe Transportation & Projects, and I founded Playhouse Media Group, the group of brands behind my web development, tendering and SaaS work.
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="tag tag-accent">Tender Management</span>
        <span class="tag tag-accent">Project Management</span>
        <span class="tag tag-neutral">Accounts Receivable</span>
        <span class="tag tag-neutral">Web Development</span>
      </div>
    </div>
  </div>

  <div id="experience" class="px-5 pb-16 pt-6 sm:px-8 md:px-14">
    <span class="kicker">Experience</span>
    <div class="mt-4 flex flex-col">
      {
        experience.map((role) => (
          <div class="border-b border-divider py-5">
            <p class="mb-1.5 text-[13px]" style="color: color-mix(in srgb, var(--color-text) 60%, transparent)">
              {role.date}
            </p>
            <h4 class="mb-1 text-base">{role.title}</h4>
            <p class="mb-2.5 text-[13px]" style="color: color-mix(in srgb, var(--color-text) 60%, transparent)">
              {role.meta}
            </p>
            <p class="card-body max-w-[60ch]">{role.body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div
    id="skills"
    class="relative left-1/2 w-screen -translate-x-1/2"
    style="background: radial-gradient(900px 420px at 85% -40%, var(--color-section-glow), transparent 64%), var(--color-section);"
  >
    <div class="mx-auto max-w-content px-5 py-14 sm:px-8 md:px-14">
      <span class="kicker mb-4">Skills</span>
      <div class="flex flex-wrap gap-2">
        {
          skills.map((skill) => (
            <span class={skill.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{skill.label}</span>
          ))
        }
      </div>
    </div>
  </div>

  <ContactBand glow="none" secondaryHref="/services" secondaryLabel="View Our Services" />
</Layout>
