---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionBand from '../components/SectionBand.astro';
import { PROFILE_PORTRAIT_URL } from '../lib/images';
import { getCollection } from 'astro:content';

const experienceList = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

const careerPillars = [
  {
    label: 'IMS Governance',
    badge: 'Appointed Rep',
    badgeClass: 'tag-accent',
    title: 'ISO 9001 · 14001 · 45001',
    description:
      'Appointed Management Representative directing company-wide quality, environmental, and occupational health & safety management systems across fleet and machinery operations.',
  },
  {
    label: 'Financial Governance',
    badge: 'Enterprise ERP',
    badgeClass: 'tag-outline',
    title: 'SAP ERP & Sage Accounting',
    description:
      'Directing accounts receivable, billing integrity, debt recovery, and financial reconciliations with structured audit trails.',
  },
  {
    label: 'Bid Acquisition',
    badge: 'Public SCM',
    badgeClass: 'tag-outline',
    title: 'Municipal & Corporate Tenders',
    description:
      'End-to-end tender lifecycle: RFP review, compliance scheduling, CIDB alignments, and competitive bid compilation.',
  },
  {
    label: 'Digital Platforms',
    badge: 'Web Architecture',
    badgeClass: 'tag-outline',
    title: 'Astro, Next.js & Tailwind',
    description:
      'Deploying accessible, semantic, and high-performance digital platforms with modern headless technology.',
  },
];

const skills = [
  { label: 'Tender Management', accent: true },
  { label: 'Project Management', accent: true },
  { label: 'AR Manager (SAP & Sage)', accent: true },
  { label: 'Tender Preparation Lifecycle', accent: true },
  { label: 'ISO 9001 (Quality)', accent: true },
  { label: 'ISO 14001 (Environmental)', accent: true },
  { label: 'ISO 45001 (Health & Safety)', accent: true },
  { label: 'Integrated Management Systems (IMS)', accent: true },
  { label: 'SHEQ Management', accent: true },
  { label: 'SAP ERP / Sage Accounting', accent: true },
  { label: 'Next.js & React', accent: true },
  { label: 'Astro.js & TypeScript', accent: true },
  { label: 'HIRA & Risk Assessment', accent: false },
  { label: 'Compliance & Auditing', accent: false },
  { label: 'Invoicing & Credit Control', accent: false },
  { label: 'Tailwind CSS', accent: false },
  { label: 'Technical SEO', accent: false },
  { label: 'Figma', accent: false },
];
---

<Layout
  title="About Jacob Chademwiri | Tender & Project Specialist"
  description="Professional background of Jacob Chademwiri: tender management, enterprise AR governance (SAP & Sage), ISO implementation, and custom web development."
  image={PROFILE_PORTRAIT_URL}
  active="about"
  schema="person"
  keywords={['Jacob Chademwiri', 'tender management', 'project management', 'AR manager', 'SAP', 'Sage accounting', 'ISO 9001', 'ISO 14001', 'ISO 45001', 'SHEQ', 'web developer', 'Centurion', 'Gauteng']}
>
  <div class="grid gap-8 px-5 py-16 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:gap-12 md:px-14">
    <figure class="m-0">
      <img
        src={PROFILE_PORTRAIT_URL}
        alt="Jacob Chademwiri, Tender & Project Manager, ISO Implementation Lead, AR Manager, Web Developer"
        width="640"
        height="800"
        class="aspect-[4/5] w-full rounded-xl object-cover"
        loading="lazy"
      />
    </figure>
    <div>
      <p class="kicker">About</p>
      <h1 class="h1 mt-4 mb-5 max-w-[18ch]">
        Submitting tenders isn't the hard part. Understanding the compliance systems behind them is.
      </h1>
      <p class="mb-6 max-w-[52ch] text-body text-text-2">
        Based in Centurion, Gauteng, I bring hands-on experience across tender acquisition, enterprise AR governance (SAP &amp; Sage), and web delivery, applying ISO quality frameworks to operational systems and digital platforms. I serve as Tender &amp; Project Manager and AR Manager at Sithembe Transportation &amp; Projects, and build custom web applications through Playhouse Media Group.
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="tag tag-accent">Tender Management</span>
        <span class="tag tag-accent">Project Management</span>
        <span class="tag tag-accent">AR Governance (SAP &amp; Sage)</span>
        <span class="tag tag-accent">ISO Standards</span>
        <span class="tag tag-neutral">Web Development</span>
      </div>
    </div>
  </div>

  <div id="experience" class="px-5 pb-20 pt-6 sm:px-8 md:px-14">
    <div class="mb-8">
      <h2 class="kicker">Experience &amp; Leadership</h2>
      <p class="h2 mt-3 max-w-[28ch]">Where operational discipline meets practical delivery.</p>
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12 xl:gap-16 items-start">
      <!-- Left: Experience Timeline -->
      <div class="flex flex-col space-y-6">
        {
          experienceList.map((role) => (
            <div class="rounded-xl border border-divider/80 bg-surface/40 p-6 backdrop-blur-xs transition-all duration-200 hover:border-accent/40 sm:p-7">
              {role.data.progression && role.data.progression.length > 0 ? (
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-divider/60 pb-3 mb-5">
                    <div>
                      <span class="font-mono text-[13px] font-semibold text-text tracking-tight uppercase">
                        {role.data.company}
                      </span>
                      <p class="text-xs text-text-3 mt-0.5">
                        {role.data.employment} · {role.data.totalDuration || role.data.period}
                      </p>
                    </div>
                    <span class="text-xs text-text-3 font-mono">{role.data.location}</span>
                  </div>

                  <div class="relative pl-5 sm:pl-6 border-l-2 border-divider/70 ml-2 space-y-6">
                    {role.data.progression.map((step) => (
                      <div class="relative group">
                        <span
                          class:list={[
                            'absolute -left-[27px] sm:-left-[31px] top-1 flex h-3.5 w-3.5 items-center justify-center rounded-full border-2 bg-surface',
                            step.current ? 'border-accent bg-accent/20' : 'border-divider group-hover:border-accent/60',
                          ]}
                        >
                          {step.current && <span class="h-1 w-1 rounded-full bg-accent" />}
                        </span>

                        <div>
                          <h4 class="text-[15px] font-semibold text-text tracking-tight">
                            {step.title}
                          </h4>
                          <p class="mt-1 mb-2 font-mono text-xs text-accent">
                            <span>{step.period}</span>
                            {step.duration && <span class="text-text-3 font-sans">· {step.duration}</span>}
                          </p>
                          <p class="text-[13px] leading-relaxed text-text-2">
                            {step.summary}
                          </p>
                          {step.skills && step.skills.length > 0 && (
                            <div class="mt-2.5 flex flex-wrap gap-1">
                              {step.skills.slice(0, 3).map((skill) => (
                                <span class="tag tag-outline text-[10.5px] py-0.5 px-2 text-text-3">
                                  {skill}
                                </span>
                              ))}
                              {step.skills.length > 3 && (
                                <span class="text-[10.5px] text-text-3 self-center">
                                  +{step.skills.length - 3} skills
                                </span>
                              )}
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>

                  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-divider/40">
                    <span class="text-xs text-text-3">Promoted across 3 leadership milestones</span>
                    <a
                      href={`/experience/${role.id}`}
                      class="btn btn-ghost text-xs text-accent hover:underline inline-flex items-center gap-1 py-1 px-2.5"
                    >
                      <span>Full role &amp; ISO scope</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              ) : (
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-divider/60 pb-3">
                    <span class="data text-meta text-accent font-medium">{role.data.period}</span>
                    <span class="font-mono text-[12px] text-text-3">{role.data.company}</span>
                  </div>

                  <h3 class="mt-3.5 text-base sm:text-[17px] font-semibold text-text tracking-tight">
                    <a href={`/experience/${role.id}`} class="hover:text-accent transition-colors">
                      {role.data.title}
                    </a>
                  </h3>
                  <p class="mt-1 text-meta text-text-3">{role.data.meta}</p>

                  <p class="mt-3.5 text-[14px] leading-relaxed text-text-2">
                    {role.data.summary}
                  </p>

                  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-divider/40">
                    <div class="flex flex-wrap gap-1.5">
                      {role.data.tags.slice(0, 4).map((tag) => (
                        <span class="tag tag-outline text-[11px] py-0.5 px-2 text-text-3">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <a
                      href={`/experience/${role.id}`}
                      class="btn btn-ghost text-xs text-accent hover:underline inline-flex items-center gap-1 py-1 px-2.5"
                    >
                      <span>Role details</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- Right: Sticky Career Overview & Standards Snapshot Card -->
      <aside class="lg:sticky lg:top-24">
        <div class="relative rounded-2xl border border-divider bg-surface/85 p-6 backdrop-blur-[14px] shadow-sm sm:p-7">
          <!-- Subtle ambient glow -->
          <div class="pointer-events-none absolute -right-12 -top-12 h-44 w-44 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

          <!-- Header -->
          <div class="mb-5 border-b border-divider pb-4">
            <div class="flex items-center gap-2">
              <span class="dot" aria-hidden="true"></span>
              <span class="font-mono text-[11px] uppercase tracking-widest text-accent font-medium">Career Overview</span>
            </div>
            <h3 class="mt-2 text-h3 font-semibold text-text">Operational Scope &amp; Standards</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-text-3">
              Applying ISO quality frameworks to corporate governance, public tenders, and digital platforms.
            </p>
          </div>

          <!-- Key Pillars -->
          <div class="flex flex-col gap-3">
            {
              careerPillars.map((pillar) => (
                <div class="rounded-xl border border-edge bg-bg/60 p-3.5 transition-all duration-200 hover:border-accent/40">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-[10px] uppercase tracking-wider text-accent font-semibold">
                      {pillar.label}
                    </span>
                    <span class:list={['tag text-[10.5px] py-0.5 px-2 font-mono', pillar.badgeClass]}>
                      {pillar.badge}
                    </span>
                  </div>
                  <h4 class="mt-1.5 text-[14px] font-medium text-text">{pillar.title}</h4>
                  <p class="mt-1 text-[12.5px] leading-relaxed text-text-2">
                    {pillar.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Key Metrics Row -->
          <div class="mt-5 grid grid-cols-3 gap-2 rounded-xl border border-edge bg-bg/40 p-3.5 text-center">
            <div>
              <p class="data text-lg font-semibold text-accent">3</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">ISO Standards</p>
            </div>
            <div class="border-x border-divider">
              <p class="data text-lg font-semibold text-text">5+ Yrs</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">Tender &amp; AR</p>
            </div>
            <div>
              <p class="data text-lg font-semibold text-text">10+</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">Web Builds</p>
            </div>
          </div>

          <!-- CTAs -->
          <div class="mt-5 flex flex-col gap-2">
            <a href="/contact" class="btn btn-primary w-full justify-center">
              <span>Discuss a project or role</span>
              <span>→</span>
            </a>
            <a href="/services" class="btn btn-secondary w-full justify-center text-xs">
              Explore all capabilities &amp; services
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <SectionBand id="skills" glow="top-right">
    <h2 class="kicker mb-5">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {
        skills.map((skill) => (
          <span class={skill.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{skill.label}</span>
        ))
      }
    </div>
  </SectionBand>

  <ContactBand headingLevel={2} glow="none" />
</Layout>
