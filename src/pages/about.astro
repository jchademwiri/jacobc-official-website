---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionBand from '../components/SectionBand.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { PROFILE_PORTRAIT_URL } from '../lib/images';
import { getCollection } from 'astro:content';

const experienceList = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

const careerPillars = [
  {
    label: '01 · Primary Role',
    badge: 'Tender Manager',
    badgeClass: 'tag-accent',
    title: 'Municipal & Corporate Tender Acquisition',
    description:
      'Leading the end-to-end tender lifecycle: opportunity vetting, RFP analysis, CSD/CIDB compliance scheduling, competitive rate modelling, and winning multi-year contracts.',
  },
  {
    label: '02 · Compliance Backbone',
    badge: 'Appointed Rep',
    badgeClass: 'tag-accent',
    title: 'ISO 9001 · 14001 · 45001 Implementation',
    description:
      'Appointed Management Representative directing company-wide quality, environmental, and occupational health & safety systems (Annex SL & DMR 19) that qualify technical bids.',
  },
  {
    label: '03 · Execution & Cash',
    badge: 'Post-Award',
    badgeClass: 'tag-outline',
    title: 'Project Delivery & SAP/Sage Billing',
    description:
      'Stepping in to run awarded contracts as needed and governing accounts receivable in SAP ERP and Sage Accounting—reconciling site milestones to invoices for zero revenue leakage.',
  },
  {
    label: '04 · Complementary Edge',
    badge: 'Bid-Tech & Web',
    badgeClass: 'tag-outline',
    title: 'TenderTrack360 & Contractor Web Platforms',
    description:
      'Building custom software (TenderTrack360 SaaS) and high-performance Astro/Next.js websites that modernize bid tracking and strengthen contractor credibility.',
  },
];

const skills = [
  { label: 'Tender Management', accent: true },
  { label: 'Project Management', accent: true },
  { label: 'AR Manager (SAP & Sage)', accent: true },
  { label: 'Tender Preparation Lifecycle', accent: true },
  { label: 'ISO 9001 (Quality)', accent: true },
  { label: 'ISO 14001 (Environmental)', accent: true },
  { label: 'ISO 45001 (Health & Safety)', accent: true },
  { label: 'Integrated Management Systems (IMS)', accent: true },
  { label: 'SHEQ Management', accent: true },
  { label: 'SAP ERP / Sage Accounting', accent: true },
  { label: 'Next.js & React', accent: true },
  { label: 'Astro.js & TypeScript', accent: true },
  { label: 'HIRA & Risk Assessment', accent: false },
  { label: 'Compliance & Auditing', accent: false },
  { label: 'Invoicing & Credit Control', accent: false },
  { label: 'Tailwind CSS', accent: false },
  { label: 'Technical SEO', accent: false },
  { label: 'Figma', accent: false },
];
---

<Layout
  title="About Jacob Chademwiri | Tender Manager · Project, ISO & Billing Lead"
  description="Professional background of Jacob Chademwiri: Tender Manager in Centurion, Gauteng who also leads ISO 9001/14001/45001 implementation, coordinates awarded projects, and governs project billing in SAP and Sage."
  image={PROFILE_PORTRAIT_URL}
  active="about"
  schema="person"
  keywords={['Jacob Chademwiri', 'tender manager', 'project manager', 'ISO implementation lead', 'AR manager', 'SAP', 'Sage accounting', 'ISO 9001', 'ISO 14001', 'ISO 45001', 'SHEQ', 'web developer', 'Centurion', 'Gauteng']}
>
  <div class="grid gap-8 px-5 py-16 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:gap-12 md:px-14">
    <figure class="m-0">
      <img
        src={PROFILE_PORTRAIT_URL}
        alt="Jacob Chademwiri, Tender & Project Manager, ISO Implementation Lead, AR Manager, Web Developer"
        width="640"
        height="800"
        class="aspect-[4/5] w-full rounded-xl object-cover"
        fetchpriority="high"
      />
    </figure>
    <div>
      <p class="kicker">About · Tender &amp; Operations Leadership</p>
      <h1 class="h1 mt-4 mb-5 max-w-[19ch]">
        A Tender Manager who knows how to qualify, run, and bill the contracts he wins.
      </h1>
      <p class="mb-4 max-w-[54ch] text-body text-text-2">
        Based in Centurion, Gauteng, my primary role is <strong>Tender Manager</strong>—leading municipal and commercial bid acquisitions from initial RFP review to contract award. What sets my work apart is what happens around the bid: I also lead the <strong>ISO 9001, 14001 &amp; 45001</strong> compliance systems that make submissions competitive, coordinate project execution as needed after award, and govern accounts receivable in <strong>SAP ERP and Sage Accounting</strong> so every delivered milestone is accurately billed and collected.
      </p>
      <p class="mb-6 max-w-[54ch] text-body text-text-2">
        To complement my operational leadership at Sithembe Transportation &amp; Projects, I also engineer bid-management software (<strong>TenderTrack360</strong>) and high-performance corporate websites through Playhouse Media Group.
      </p>
      <div class="flex flex-wrap gap-2">
        <span class="tag tag-accent">Tender Management (Primary)</span>
        <span class="tag tag-accent">ISO 9001 · 14001 · 45001 Lead</span>
        <span class="tag tag-accent">Project Execution</span>
        <span class="tag tag-accent">Project Billing (SAP &amp; Sage)</span>
        <span class="tag tag-neutral">Complementary: Web &amp; SaaS</span>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact?type=employment" class="btn btn-primary">Discuss a Role or Tender →</a>
        <a href="/resume" class="btn btn-secondary">Executive Resume / One-Pager →</a>
      </div>
    </div>
  </div>

  <!-- Quantified Impact Metrics Strip -->
  <div class="px-5 pb-10 sm:px-8 md:px-14">
    <MetricStrip />
  </div>

  <div id="experience" class="px-5 pb-20 pt-6 sm:px-8 md:px-14">
    <div class="mb-8">
      <p class="kicker">Experience &amp; Leadership</p>
      <h2 class="h2 mt-3 max-w-[28ch]">Where operational discipline meets practical delivery.</h2>
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12 xl:gap-16 items-start">
      <!-- Left: Experience Timeline -->
      <div class="flex flex-col space-y-6">
        {
          experienceList.map((role) => (
            <div class="rounded-xl border border-divider/80 bg-surface/40 p-6 backdrop-blur-xs transition-all duration-200 hover:border-accent/40 sm:p-7">
              <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-divider/60 pb-3">
                <span class="data text-meta text-accent font-medium">{role.data.period}</span>
                <span class="font-mono text-[12px] text-text-3">{role.data.company}</span>
              </div>

              <h3 class="mt-3.5 text-base sm:text-[17px] font-semibold text-text tracking-tight">
                <a href={`/experience/${role.id}`} class="hover:text-accent transition-colors">
                  {role.data.title}
                </a>
              </h3>
              <p class="mt-1 text-meta text-text-3">{role.data.meta}</p>

              <p class="mt-3.5 text-[14px] leading-relaxed text-text-2">
                {role.data.summary}
              </p>

              <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-divider/40">
                <div class="flex flex-wrap gap-1.5">
                  {role.data.tags.slice(0, 4).map((tag) => (
                    <span class="tag tag-outline text-[11px] py-0.5 px-2 text-text-3">
                      {tag}
                    </span>
                  ))}
                </div>

                <a
                  href={`/experience/${role.id}`}
                  class="btn btn-ghost text-xs text-accent hover:underline inline-flex items-center gap-1 py-1 px-2.5"
                >
                  <span>{role.data.progression && role.data.progression.length > 0 ? 'Career progression & details' : 'Role details'}</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Right: Sticky Career Overview & Standards Snapshot Card -->
      <aside class="lg:sticky lg:top-24">
        <div class="relative rounded-2xl border border-divider bg-surface/85 p-6 backdrop-blur-[14px] shadow-sm sm:p-7">
          <!-- Subtle ambient glow -->
          <div class="pointer-events-none absolute -right-12 -top-12 h-44 w-44 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>

          <!-- Header -->
          <div class="mb-5 border-b border-divider pb-4">
            <div class="flex items-center gap-2">
              <span class="dot" aria-hidden="true"></span>
              <span class="font-mono text-[11px] uppercase tracking-widest text-accent font-medium">Career Overview</span>
            </div>
            <h3 class="mt-2 text-h3 font-semibold text-text">Operational Scope &amp; Standards</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-text-3">
              Applying ISO quality frameworks to corporate governance, public tenders, and digital platforms.
            </p>
          </div>

          <!-- Key Pillars -->
          <div class="flex flex-col gap-3">
            {
              careerPillars.map((pillar) => (
                <div class="rounded-xl border border-edge bg-bg/60 p-3.5 transition-all duration-200 hover:border-accent/40">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-[10px] uppercase tracking-wider text-accent font-semibold">
                      {pillar.label}
                    </span>
                    <span class:list={['tag text-[10.5px] py-0.5 px-2 font-mono', pillar.badgeClass]}>
                      {pillar.badge}
                    </span>
                  </div>
                  <h4 class="mt-1.5 text-[14px] font-medium text-text">{pillar.title}</h4>
                  <p class="mt-1 text-[12.5px] leading-relaxed text-text-2">
                    {pillar.description}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Key Metrics Row -->
          <div class="mt-5 grid grid-cols-3 gap-2 rounded-xl border border-edge bg-bg/40 p-3.5 text-center">
            <div>
              <p class="data text-lg font-semibold text-accent">5+ Won</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">3-Yr Tenders</p>
            </div>
            <div class="border-x border-divider">
              <p class="data text-lg font-semibold text-text">3 ISO</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">IMS Standards</p>
            </div>
            <div>
              <p class="data text-lg font-semibold text-text">SAP/Sage</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-text-3">AR &amp; Billing</p>
            </div>
          </div>

          <!-- CTAs -->
          <div class="mt-5 flex flex-col gap-2">
            <a href="/contact?type=employment" class="btn btn-primary w-full justify-center">
              <span>Discuss a role or tender</span>
              <span>→</span>
            </a>
            <a href="/resume" class="btn btn-secondary w-full justify-center text-xs">
              View printable Executive Resume
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <SectionBand id="skills" glow="top-right">
    <h2 class="kicker mb-5">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {
        skills.map((skill) => (
          <span class={skill.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{skill.label}</span>
        ))
      }
    </div>
  </SectionBand>

  <ContactBand headingLevel={2} glow="none" />
</Layout>
