---
import Layout from '../layouts/Layout.astro';
import {
  siteConfig,
  metricsStrip,
  coreCapabilities,
  contractPortfolio,
  experienceTimeline,
  credentialsList,
} from '../data/siteData';

const companyMonograms: Record<string, string> = {
  'Sithembe Transportation and Projects': 'STP',
  'Babiya Geomatics and Trading': 'BG',
  'Baum Systems (Pty) Ltd': 'BS',
  'CORPCLO CC': 'CC',
};

const contractGroups = [
  {
    label: 'Electrical Supply & Accessories',
    items: contractPortfolio.filter((c) => c.category === 'Electrical Supply'),
  },
  {
    label: 'Heavy Plant, Fleet & Waste Vehicles',
    items: contractPortfolio.filter((c) => c.category === 'Plant & Fleet Hire'),
  },
  {
    label: 'Water, Sanitation & Civil Supply',
    items: contractPortfolio.filter((c) => c.category === 'Water & Sanitation'),
  },
  {
    label: 'Civil, Building & Horticulture',
    items: contractPortfolio.filter((c) => c.category === 'Civil, Building & Horticulture'),
  },
];

const entityBreakdown = [
  { name: 'City of Tshwane', count: contractPortfolio.filter((c) => c.entity === 'City of Tshwane').length },
  { name: 'City of Ekurhuleni', count: contractPortfolio.filter((c) => c.entity === 'City of Ekurhuleni').length },
  { name: 'Pikitup Johannesburg', count: contractPortfolio.filter((c) => c.entity === 'Pikitup Johannesburg').length },
  { name: 'Msunduzi Municipality', count: contractPortfolio.filter((c) => c.entity === 'Msunduzi Municipality').length },
];

const erpSystems = ['SAP', 'Sage', 'Zoho', 'Microsoft 365'];
const governanceStandards = ['ISO 9001', 'ISO 14001', 'ISO 45001', 'MFMA / SCM', 'CIDB', 'SANS 1294:2020'];
---

<Layout
  title="Executive CV"
  description={`Executive curriculum vitae of ${siteConfig.name}, ${siteConfig.title} based in ${siteConfig.location}.`}
>
  <div class="mx-auto max-w-content px-5 py-10 sm:px-8 print:max-w-none print:p-0">
    <!-- Top Action Bar (Screen Only) -->
    <div class="no-print mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-border pb-5">
      <a href="/" class="btn btn-secondary min-h-[38px] px-4 py-2 text-xs">
        <span>← Portfolio</span>
      </a>
      <a href="/track-record" class="data text-xs font-medium text-accent hover:underline">
        Full 16-Contract Track Record →
      </a>
    </div>

    <!-- Executive CV Document Sheet -->
    <article class="cv-sheet overflow-hidden rounded-2xl border border-border bg-surface shadow-xs print:rounded-none print:border-none print:bg-transparent print:shadow-none">
      <!-- Top Warm Bronze Accent Rule -->
      <div class="h-1.5 w-full bg-accent print:h-1"></div>

      <!-- Executive Header Band -->
      <header class="cv-block border-b border-border bg-surface-2/60 px-6 py-7 sm:px-10 sm:py-8 print:bg-transparent print:px-0 print:py-4">
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-start">
          <div>
            <p class="data text-[11px] font-medium uppercase tracking-[0.14em] text-accent">
              Executive Curriculum Vitae
            </p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-primary sm:text-4xl print:text-2xl">
              {siteConfig.name}
            </h1>
            <p class="mt-1.5 text-base font-medium text-accent sm:text-lg print:text-sm">
              {siteConfig.title}
            </p>
            <p class="mt-2 max-w-xl text-xs leading-relaxed text-muted sm:text-sm print:text-xs">
              Municipal Supply Chain &amp; Heavy Plant/Fleet Hire &middot; Technical OEM Sourcing &middot; SAP, Sage &amp; Zoho &middot; ISO 9001/14001/45001
            </p>
          </div>

          <!-- Right Contact Details Grid -->
          <div class="grid gap-1.5 text-xs text-text-2 sm:grid-cols-2 lg:grid-cols-1 lg:text-right print:grid-cols-2 print:text-left">
            <a href={siteConfig.phoneHref} class="data font-medium text-primary hover:text-accent">
              {siteConfig.phone}
            </a>
            <a href={`mailto:${siteConfig.email}`} class="data font-medium text-primary hover:text-accent">
              {siteConfig.email}
            </a>
            <a href={siteConfig.website} class="data hover:text-accent">
              www.jacobc.co.za
            </a>
            <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="data hover:text-accent">
              linkedin.com/in/jchademwiri
            </a>
            <p class="data text-muted">{siteConfig.location}</p>
            <p class="data text-muted">{siteConfig.license}</p>
          </div>
        </div>

        <!-- Compact 4-Metric Proof Strip -->
        <div class="mt-6 grid grid-cols-2 gap-3 border-t border-border pt-5 sm:grid-cols-4 print:mt-4 print:gap-2 print:pt-3">
          {
            metricsStrip.map((m) => (
              <div class="rounded-lg border border-border bg-surface px-3.5 py-2.5 print:bg-transparent print:px-2.5 print:py-1.5">
                <p class="data text-lg font-semibold text-primary sm:text-xl print:text-sm">{m.value}</p>
                <p class="mt-0.5 text-[11px] leading-snug text-muted">{m.label}</p>
              </div>
            ))
          }
        </div>
      </header>

      <!-- Main 2-Column Editorial Body -->
      <div class="grid gap-8 px-6 py-8 sm:px-10 lg:grid-cols-12 lg:gap-10 print:block print:px-0 print:py-4">
        <!-- Left Main Column (8 cols) -->
        <div class="space-y-8 lg:col-span-8 print:space-y-5">
          <!-- Executive Profile -->
          <section class="cv-block">
            <h2 class="cv-heading">Executive Profile</h2>
            <p class="mt-3 text-sm leading-relaxed text-text-2 print:text-[10pt]">
              Procurement, Tender &amp; Contract Manager with 5+ years of commercial experience across public-sector supply, heavy plant and fleet hire, water and sanitation, civil/building refurbishment, and municipal maintenance. Over the past five years, I have bid, won (~85% success rate), inherited, and managed <strong class="text-primary">10+ multi-year contracts</strong> for the City of Tshwane, City of Ekurhuleni, Pikitup Johannesburg, and Msunduzi Municipality. My day-to-day work covers direct OEM sourcing (ACTOM, M-TEC), CPI/CPIX price escalations, MFMA/SCM compliance, commercial invoicing in SAP, Sage, and Zoho, and ISO 9001, 14001, and 45001 management system leadership.
            </p>
          </section>

          <!-- Professional Experience (Grouped Company + Vertical Progression Rail) -->
          <section class="border-t border-border pt-7 print:pt-4">
            <h2 class="cv-heading">Professional Experience</h2>

            <div class="mt-5 space-y-6 print:mt-3 print:space-y-4">
              {
                experienceTimeline.map((company, companyIdx) => (
                  <div class="cv-block rounded-xl border border-border bg-surface-2/60 p-5 print:rounded-none print:border-0 print:border-b print:bg-transparent print:p-0 print:pb-3">
                    <!-- Company Header with Monogram -->
                    <div class="flex items-start gap-3.5">
                      <div
                        class:list={[
                          'flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border font-mono text-xs font-bold tracking-tight print:h-8 print:w-8',
                          companyIdx === 0
                            ? 'border-accent/40 bg-accent-soft text-accent'
                            : 'border-border bg-surface text-muted',
                        ]}
                        aria-hidden="true"
                      >
                        {companyMonograms[company.company] ?? 'CO'}
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                          <h3 class="text-base font-bold tracking-tight text-primary print:text-sm">
                            {company.company}
                          </h3>
                          <span class="data text-xs text-muted">{company.location}</span>
                        </div>
                        {companyIdx === 0 && (
                          <p class="data mt-0.5 text-[11px] font-medium text-accent">
                            Jan 2022 – Present &middot; 3 Progressive Roles
                          </p>
                        )}
                      </div>
                    </div>

                    <!-- Roles with Vertical Progression Rail -->
                    <div
                      class:list={[
                        'mt-4 space-y-5 print:mt-2.5 print:space-y-3',
                        company.roles.length > 1 && 'relative ml-5 border-l-2 border-border pl-6 print:ml-4 print:pl-4',
                      ]}
                    >
                      {
                        company.roles.map((role, roleIdx) => (
                          <div class="relative">
                            {company.roles.length > 1 && (
                              <span
                                class:list={[
                                  'absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 print:-left-[23px]',
                                  roleIdx === 0
                                    ? 'border-accent bg-accent'
                                    : 'border-border bg-surface',
                                ]}
                                aria-hidden="true"
                              />
                            )}

                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                              <h4 class="text-sm font-semibold text-primary print:text-xs">
                                {role.title}
                              </h4>
                              <span class="data text-xs font-medium text-accent print:text-[10.5px]">
                                {role.period}
                              </span>
                            </div>

                            <ul class="mt-2.5 space-y-1.5 text-[13.5px] leading-relaxed text-text-2 print:mt-1.5 print:space-y-1 print:text-[9.5pt]">
                              {
                                role.highlights.map((hl) => (
                                  <li class="flex items-start gap-2.5">
                                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/80 print:mt-1.5" aria-hidden="true" />
                                    <span>{hl}</span>
                                  </li>
                                ))
                              }
                            </ul>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Verified Municipal Contract Portfolio (Structured 2x2 Grid) -->
          <section class="cv-block border-t border-border pt-7 print:pt-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="cv-heading">Verified Municipal Contract Portfolio ({contractPortfolio.length} Awards)</h2>
              <a href="/track-record" class="no-print data text-xs font-medium text-accent hover:underline">
                Interactive Filter View →
              </a>
            </div>

            <div class="mt-4 grid gap-3.5 sm:grid-cols-2 print:mt-2.5 print:gap-2.5">
              {
                contractGroups.map((group) => (
                  <div class="rounded-xl border border-border border-l-[3px] border-l-accent bg-surface-2/60 p-4 print:bg-transparent print:p-2.5">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-primary">
                      {group.label}
                    </h3>
                    <ul class="mt-2.5 space-y-1.5 text-xs leading-snug text-text-2 print:mt-1.5 print:space-y-1">
                      {
                        group.items.map((c) => (
                          <li>
                            <span class="data font-semibold text-accent">{c.ref}</span>
                            <span class="text-muted"> ({c.entity}):</span>{' '}
                            <span>{c.title}</span>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                ))
              }
            </div>
          </section>
        </div>

        <!-- Right Executive Sidebar (4 cols) -->
        <aside class="space-y-6 lg:col-span-4 lg:border-l lg:border-border lg:pl-8 print:mt-5 print:border-t print:border-border print:pt-4">
          <!-- Core Competencies -->
          <section class="cv-block">
            <h2 class="cv-heading">Core Competencies</h2>
            <div class="mt-4 space-y-3.5 print:mt-2.5 print:grid print:grid-cols-2 print:gap-2.5 print:space-y-0">
              {
                coreCapabilities.map((cap, i) => (
                  <div class="rounded-lg border border-border bg-surface-2/60 p-3.5 print:bg-transparent print:p-2.5">
                    <p class="data text-[10px] font-semibold uppercase tracking-widest text-accent">
                      0{i + 1}
                    </p>
                    <h3 class="mt-0.5 text-xs font-semibold text-primary">{cap.title}</h3>
                    <div class="mt-2 flex flex-wrap gap-1">
                      {
                        cap.tags.map((tag) => (
                          <span class="pill pill-neutral px-2 py-0.5 text-[10.5px]">{tag}</span>
                        ))
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Municipal Entities Served -->
          <section class="cv-block border-t border-border pt-6 print:pt-3">
            <h2 class="cv-heading">Municipal Entities Served</h2>
            <ul class="mt-3 space-y-2 text-xs print:mt-2 print:grid print:grid-cols-2 print:gap-2 print:space-y-0">
              {
                entityBreakdown.map((ent) => (
                  <li class="flex items-center justify-between rounded-lg border border-border bg-surface-2/60 px-3 py-2 print:bg-transparent print:py-1.5">
                    <span class="font-medium text-primary">{ent.name}</span>
                    <span class="data font-semibold text-accent">
                      {ent.count} {ent.count === 1 ? 'contract' : 'contracts'}
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- ERP & Governance Stack -->
          <section class="cv-block border-t border-border pt-6 print:pt-3">
            <h2 class="cv-heading">Systems &amp; Standards</h2>
            <div class="mt-3 space-y-3 print:mt-2">
              <div>
                <p class="data mb-1.5 text-[10.5px] uppercase tracking-wider text-muted">
                  ERP &amp; Invoicing
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {erpSystems.map((s) => <span class="pill pill-bronze">{s}</span>)}
                </div>
              </div>
              <div>
                <p class="data mb-1.5 text-[10.5px] uppercase tracking-wider text-muted">
                  Compliance &amp; Governance
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {governanceStandards.map((s) => <span class="pill pill-neutral">{s}</span>)}
                </div>
              </div>
            </div>
          </section>

          <!-- Education & Credentials -->
          <section class="cv-block border-t border-border pt-6 print:pt-3">
            <h2 class="cv-heading">Education &amp; Credentials</h2>
            <ul class="mt-3 space-y-3 text-xs print:mt-2 print:space-y-1.5">
              {
                credentialsList.map((cred) => (
                  <li class="border-l-2 border-accent/50 pl-3">
                    <p class="font-semibold text-primary">{cred.title}</p>
                    <p class="data mt-0.5 text-[11px] text-muted">{cred.issuer}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- References -->
          <section class="cv-block border-t border-border pt-5 print:pt-3">
            <h2 class="cv-heading">References</h2>
            <p class="mt-2 text-xs text-text-2">
              Available upon request for shortlisted opportunities.
            </p>
          </section>
        </aside>
      </div>
    </article>
  </div>
</Layout>

<style>
  .cv-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cv-heading::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 1.5px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  @media print {
    .cv-block {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    @page {
      margin: 1cm;
      size: A4 portrait;
    }
  }
</style>
