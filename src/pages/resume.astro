---
import Layout from '../layouts/Layout.astro';
import {
  siteConfig,
  coreCapabilities,
  contractPortfolio,
  experienceTimeline,
  credentialsList,
  systemsAndStandards,
} from '../data/siteData';

const categories = [
  {
    label: 'Electrical Supply & Accessories',
    items: contractPortfolio.filter((c) => c.category === 'Electrical Supply'),
  },
  {
    label: 'Heavy Plant, Fleet & Waste Vehicles',
    items: contractPortfolio.filter((c) => c.category === 'Plant & Fleet Hire'),
  },
  {
    label: 'Water, Sanitation & Civil Supply',
    items: contractPortfolio.filter((c) => c.category === 'Water & Sanitation'),
  },
  {
    label: 'Civil, Building & Municipal Horticulture',
    items: contractPortfolio.filter((c) => c.category === 'Civil, Building & Horticulture'),
  },
];
---

<Layout
  title="Executive CV"
  description={`Executive curriculum vitae of ${siteConfig.name}, ${siteConfig.title} based in ${siteConfig.location}.`}
>
  <div class="mx-auto max-w-content px-5 py-10 sm:px-8 print:p-0">
    <!-- Top Action Bar (Screen Only) -->
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3 border-b border-border pb-5">
      <a href="/" class="btn btn-secondary min-h-[38px] px-4 py-2 text-xs">
        <span>← Back to Portfolio</span>
      </a>

      <div class="flex flex-wrap items-center gap-2.5">
        <a href={siteConfig.cvPath} download class="btn btn-secondary min-h-[38px] px-4 py-2 text-xs">
          <span>Download PDF (v4)</span>
        </a>
        <button
          type="button"
          id="print-cv-btn"
          class="btn btn-primary min-h-[38px] px-4 py-2 text-xs"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Print / Save as PDF</span>
        </button>
      </div>
    </div>

    <!-- Executive CV Sheet -->
    <article class="cv-sheet rounded-xl border border-border bg-surface p-6 sm:p-10 print:border-none print:bg-transparent print:p-0">
      <!-- Header -->
      <header class="cv-block border-b border-border pb-6">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-baseline">
          <div>
            <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl print:text-2xl">
              {siteConfig.name}
            </h1>
            <p class="mt-1 font-mono text-sm font-medium text-accent print:text-xs">
              {siteConfig.title}
            </p>
            <p class="mt-1 text-xs text-muted">
              Municipal Supply Chain &amp; Fleet/Plant Hire &middot; SAP, Sage &amp; Zoho &middot; ISO / SHEQ
            </p>
          </div>
          <div class="sm:text-right">
            <p class="data text-xs text-text-2">{siteConfig.location}</p>
            <p class="data mt-0.5 text-xs text-muted">{siteConfig.license}</p>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-2">
          <a href={siteConfig.phoneHref} class="data hover:text-accent">{siteConfig.phone}</a>
          <span class="text-muted">&middot;</span>
          <a href={`mailto:${siteConfig.email}`} class="data hover:text-accent">{siteConfig.email}</a>
          <span class="text-muted">&middot;</span>
          <a href={siteConfig.website} class="data hover:text-accent">jacobc.co.za</a>
          <span class="text-muted">&middot;</span>
          <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="data hover:text-accent">
            linkedin.com/in/jchademwiri
          </a>
        </div>
      </header>

      <!-- Professional Summary -->
      <section class="cv-block border-b border-border py-6 print:py-4">
        <h2 class="data mb-2.5 text-xs font-semibold uppercase tracking-widest text-accent">
          Professional Summary
        </h2>
        <p class="text-sm leading-relaxed text-text-2 print:text-[10pt]">
          Results-driven <strong class="text-primary">Procurement, Tender &amp; Contract Manager</strong> with 5+ years of end-to-end commercial experience across public-sector supply, heavy plant and fleet hire, water and sanitation, civil/building works, and municipal maintenance portfolios. Proven track record of bidding, winning (~85% success rate), and managing <strong class="text-primary">17+ multi-year contracts</strong> across four major municipal entities: City of Tshwane, City of Ekurhuleni, Pikitup Johannesburg (CoJ), and Msunduzi Municipality. Skilled in tier-1 technical sourcing (ACTOM, M-TEC), CPI/CPIX escalation management, MFMA/SCM compliance, ERP commercial invoicing (SAP, Sage, Zoho), and ISO 9001, 14001, and 45001 governance.
        </p>
      </section>

      <!-- Core Competencies -->
      <section class="cv-block border-b border-border py-6 print:py-4">
        <h2 class="data mb-3.5 text-xs font-semibold uppercase tracking-widest text-accent">
          Core Competencies
        </h2>
        <div class="grid gap-3.5 sm:grid-cols-2 print:gap-2.5">
          {
            coreCapabilities.map((cap) => (
              <div class="rounded-lg border border-border bg-surface-2 p-4 print:bg-transparent print:p-2.5">
                <p class="text-sm font-semibold text-primary print:text-xs">{cap.title}</p>
                <p class="mt-1 text-xs leading-relaxed text-text-2">{cap.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Verified Municipal Contract Portfolio -->
      <section class="cv-block border-b border-border py-6 print:py-4">
        <h2 class="data mb-3.5 text-xs font-semibold uppercase tracking-widest text-accent">
          Verified Municipal Contract Portfolio (17+ Multi-Year Awards)
        </h2>
        <div class="space-y-3 text-xs leading-relaxed text-text-2 print:space-y-2">
          {
            categories.map((group) => (
              <p>
                <strong class="text-primary">{group.label}:</strong>{' '}
                {group.items.map((c) => `${c.ref} (${c.entity} — ${c.title})`).join('; ')}.
              </p>
            ))
          }
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="border-b border-border py-6 print:py-4">
        <h2 class="data mb-4 text-xs font-semibold uppercase tracking-widest text-accent">
          Professional Experience
        </h2>
        <div class="space-y-6 print:space-y-4">
          {
            experienceTimeline.map((company) => (
              <div class="cv-block">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-base font-semibold text-primary print:text-sm">{company.company}</h3>
                  <span class="data text-xs text-muted">{company.location}</span>
                </div>

                <div class="mt-3 space-y-4 print:mt-2 print:space-y-2.5">
                  {
                    company.roles.map((role) => (
                      <div>
                        <div class="flex flex-wrap items-baseline justify-between gap-2">
                          <h4 class="text-sm font-semibold text-primary print:text-xs">{role.title}</h4>
                          <span class="data text-xs font-medium text-accent">{role.period}</span>
                        </div>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs leading-relaxed text-text-2 print:mt-1 print:space-y-0.5">
                          {role.highlights.map((hl) => <li>{hl}</li>)}
                        </ul>
                      </div>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Education, Credentials & Systems -->
      <section class="cv-block pt-6 print:pt-4">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <h2 class="data mb-3 text-xs font-semibold uppercase tracking-widest text-accent">
              Education &amp; Credentials
            </h2>
            <ul class="space-y-2 text-xs text-text-2">
              {
                credentialsList.map((cred) => (
                  <li>
                    <strong class="text-primary">{cred.title}</strong>
                    <span class="block text-muted">{cred.issuer}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="data mb-3 text-xs font-semibold uppercase tracking-widest text-accent">
              Systems &amp; Governance Standards
            </h2>
            <div class="flex flex-wrap gap-1.5">
              {
                systemsAndStandards.map((std) => (
                  <span class="pill pill-neutral">{std}</span>
                ))
              }
            </div>
            <p class="mt-4 text-xs text-muted">
              <strong class="text-primary">References:</strong> Available upon request.
            </p>
          </div>
        </div>
      </section>
    </article>
  </div>
</Layout>

<script>
  document.getElementById('print-cv-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  @media print {
    .cv-block {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    @page {
      margin: 1.1cm;
      size: A4 portrait;
    }
  }
</style>
