---
import Layout from '../layouts/Layout.astro';
import {
  SITE_NAME,
  PERSON_JOB_TITLE,
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  LOCALITY,
  REGION,
  COUNTRY,
  GITHUB_URL,
  LINKEDIN_URL,
} from '../lib/site';
---

<Layout
  fullTitle={`Executive Resume & Profile | ${SITE_NAME}`}
  description="Executive curriculum vitae and professional overview of Jacob Chademwiri: Tender & Project Manager, ISO Implementation Lead, AR Manager, and Web Developer."
  active="about"
  schema="person"
>
  <div class="mx-auto max-w-[880px] px-5 py-10 sm:px-8 print:max-w-none print:p-0">
    <!-- Top Action Bar (Screen only, hidden when printing) -->
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3 border-b border-divider/60 pb-5">
      <a href="/about" class="btn btn-secondary inline-flex items-center gap-1.5 text-xs">
        <span>← Back to About</span>
      </a>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="print-btn"
          class="btn btn-primary inline-flex items-center gap-2 text-xs cursor-pointer shadow-xs"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Print / Save as PDF</span>
        </button>
      </div>
    </div>

    <!-- Resume Document Sheet -->
    <article class="resume-sheet rounded-2xl border border-divider/80 bg-surface/50 p-7 sm:p-10 backdrop-blur-xs shadow-sm print:border-none print:bg-transparent print:p-0 print:shadow-none">
      <!-- Header -->
      <header class="border-b border-divider/70 pb-6 mb-7 print:border-black/20 print:pb-5 print:mb-5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text print:text-black">
              {SITE_NAME}
            </h1>
            <p class="font-mono text-xs sm:text-[13px] text-accent font-medium mt-1 print:text-neutral-700">
              {PERSON_JOB_TITLE}
            </p>
          </div>
          <p class="text-xs text-text-3 font-mono print:text-neutral-600">
            {LOCALITY}, {REGION}, {COUNTRY}
          </p>
        </div>

        <!-- Contact Links -->
        <div class="mt-4 flex flex-wrap items-center gap-y-1.5 gap-x-4 text-xs text-text-2 print:text-neutral-700">
          <a href={CONTACT_MAILTO} class="hover:text-accent print:text-black">
            {CONTACT_EMAIL}
          </a>
          <span class="text-text-3 print:text-neutral-400">·</span>
          <a href="https://www.jacobc.co.za" class="hover:text-accent print:text-black">
            www.jacobc.co.za
          </a>
          <span class="text-text-3 print:text-neutral-400">·</span>
          <a href={LINKEDIN_URL} class="hover:text-accent print:text-black">
            linkedin.com/in/jchademwiri
          </a>
          <span class="text-text-3 print:text-neutral-400">·</span>
          <a href={GITHUB_URL} class="hover:text-accent print:text-black">
            github.com/jchademwiri
          </a>
        </div>
      </header>

      <!-- Executive Summary -->
      <section class="mb-7 print:mb-5">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent font-semibold mb-2 print:text-black">
          Executive Summary
        </h2>
        <p class="text-[13.5px] leading-relaxed text-text-2 print:text-neutral-800">
          Multidisciplinary operational manager combining public procurement bid leadership, Integrated Management System (IMS) governance across ISO 9001, 14001, and 45001, corporate accounts receivable reconciliation, and modern web application development. Proven track record steering high-value municipal tender acquisitions, developing enterprise standard operating procedures, and building fast, accessible digital platforms.
        </p>
      </section>

      <!-- Core Competencies Grid -->
      <section class="mb-8 border-y border-divider/60 py-6 print:border-black/20 print:py-4 print:mb-5">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent font-semibold mb-3 print:text-black">
          Core Competencies &amp; Technical Disciplines
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-text-2 print:text-neutral-800">
          <div class="rounded-lg border border-edge/60 bg-bg/40 p-3.5 print:border-neutral-300 print:bg-transparent">
            <p class="font-semibold text-text mb-1 print:text-black">Tender &amp; Procurement Leadership</p>
            <p class="leading-relaxed text-text-3 print:text-neutral-700">
              RFP document analysis, mandatory returnable schedules, municipal SCM compliance, CSD, CIDB alignments, SBD forms, commercial pricing models, and physical bid submission logistics.
            </p>
          </div>
          <div class="rounded-lg border border-edge/60 bg-bg/40 p-3.5 print:border-neutral-300 print:bg-transparent">
            <p class="font-semibold text-text mb-1 print:text-black">ISO Standards &amp; SHEQ Governance</p>
            <p class="leading-relaxed text-text-3 print:text-neutral-700">
              Integrated Management Systems (ISO 9001:2015, ISO 14001:2015, ISO 45001:2018), Annex SL structure, standard operating procedures (SOPs), baseline HIRA risk registers, and statutory machinery compliance.
            </p>
          </div>
          <div class="rounded-lg border border-edge/60 bg-bg/40 p-3.5 print:border-neutral-300 print:bg-transparent">
            <p class="font-semibold text-text mb-1 print:text-black">Financial Governance &amp; AR Integrity</p>
            <p class="leading-relaxed text-text-3 print:text-neutral-700">
              Corporate Accounts Receivable governance via SAP ERP and Sage Accounting, invoice verification, milestone reconciliation, dispute resolution, and credit control audit trails.
            </p>
          </div>
          <div class="rounded-lg border border-edge/60 bg-bg/40 p-3.5 print:border-neutral-300 print:bg-transparent">
            <p class="font-semibold text-text mb-1 print:text-black">Web Engineering &amp; SaaS Systems</p>
            <p class="leading-relaxed text-text-3 print:text-neutral-700">
              Astro, Next.js, React, TypeScript, Tailwind CSS, semantic HTML, Google Lighthouse 95–100 benchmark, structured schema markup, and responsive design systems.
            </p>
          </div>
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="mb-8 print:mb-5">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent font-semibold mb-4 print:text-black">
          Professional Experience
        </h2>

        <!-- Sithembe Transportation & Projects -->
        <div class="mb-7 pb-6 border-b border-divider/40 print:border-neutral-300 print:mb-4 print:pb-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <div>
              <h3 class="text-[15px] font-bold text-text print:text-black">
                Sithembe Transportation &amp; Projects
              </h3>
              <p class="text-xs text-text-3 print:text-neutral-600">
                Centurion, Gauteng · Full-time · 4+ Years Tenure
              </p>
            </div>
            <span class="font-mono text-xs text-accent font-medium print:text-neutral-800">
              Jan 2022 – Present
            </span>
          </div>

          <!-- Progressive Roles at STP -->
          <div class="mt-3 space-y-4 pl-3 border-l-2 border-divider/60 print:border-neutral-400">
            <div>
              <div class="flex items-baseline justify-between">
                <h4 class="text-xs font-semibold text-text print:text-black">
                  Tender &amp; Project Manager | ISO Implementation Lead | AR Manager
                </h4>
                <span class="font-mono text-[11px] text-accent print:text-neutral-600">Nov 2023 – Present</span>
              </div>
              <ul class="mt-1.5 space-y-1 text-xs text-text-2 list-disc list-inside print:text-neutral-800">
                <li>Appointed Management Representative directing the company-wide Integrated Management System across ISO 9001:2015, ISO 14001:2015, and ISO 45001:2018.</li>
                <li>Steer high-value municipal tender acquisitions, including multi-year City of Tshwane tenders for plant hire, mobile sanitation, and water tankers.</li>
                <li>Direct corporate accounts receivable in SAP ERP and Sage Accounting, resolving billing queries and ensuring zero revenue leakage.</li>
              </ul>
            </div>

            <div>
              <div class="flex items-baseline justify-between">
                <h4 class="text-xs font-semibold text-text print:text-black">
                  Senior Tendering Administrator &amp; IT Support Technician
                </h4>
                <span class="font-mono text-[11px] text-text-3 print:text-neutral-600">Sep 2022 – Nov 2023</span>
              </div>
              <ul class="mt-1.5 space-y-1 text-xs text-text-2 list-disc list-inside print:text-neutral-800">
                <li>Oversaw end-to-end tender preparation, compliance verification, and competitive bid compilation.</li>
                <li>Engineered and launched the Sithembe Transportation &amp; Projects official website and managed internal IT infrastructure.</li>
              </ul>
            </div>

            <div>
              <div class="flex items-baseline justify-between">
                <h4 class="text-xs font-semibold text-text print:text-black">
                  Tendering Administrator
                </h4>
                <span class="font-mono text-[11px] text-text-3 print:text-neutral-600">Jan 2022 – Aug 2022</span>
              </div>
              <ul class="mt-1.5 space-y-1 text-xs text-text-2 list-disc list-inside print:text-neutral-800">
                <li>Compiled returnable compliance packs, managed CSD registrations, tax pins, and CIDB alignments for public tenders.</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Playhouse Media Group -->
        <div class="mb-7 pb-6 border-b border-divider/40 print:border-neutral-300 print:mb-4 print:pb-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <div>
              <h3 class="text-[15px] font-bold text-text print:text-black">
                Playhouse Media Group
              </h3>
              <p class="text-xs text-text-3 print:text-neutral-600">
                Gauteng, South Africa · Founder &amp; Lead Developer
              </p>
            </div>
            <span class="font-mono text-xs text-accent font-medium print:text-neutral-800">
              Jan 2020 – Present
            </span>
          </div>
          <ul class="mt-1.5 space-y-1 text-xs text-text-2 list-disc list-inside print:text-neutral-800">
            <li>Delivered 10+ custom web platforms using Next.js, Astro, React, TypeScript, and Tailwind CSS.</li>
            <li>Engineered TenderTrack360, a specialized tender and compliance pipeline management SaaS application.</li>
            <li>Maintained 95–100 Google Lighthouse scores across performance, accessibility, SEO, and web standards.</li>
          </ul>
        </div>

        <!-- Babiya Geomatics and Trading -->
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <div>
              <h3 class="text-[15px] font-bold text-text print:text-black">
                Babiya Geomatics and Trading
              </h3>
              <p class="text-xs text-text-3 print:text-neutral-600">
                South Africa · Tender &amp; Office Administrator
              </p>
            </div>
            <span class="font-mono text-xs text-accent font-medium print:text-neutral-800">
              Jan 2021 – Jan 2022
            </span>
          </div>
          <ul class="mt-1.5 space-y-1 text-xs text-text-2 list-disc list-inside print:text-neutral-800">
            <li>Built foundational tendering discipline: reading RFP criteria, returnables, and statutory tender pack compilation.</li>
            <li>Maintained Central Supplier Database (CSD) profiles, tax clearance certificates, and vendor alignments.</li>
          </ul>
        </div>
      </section>

      <!-- Key Standards & Software Stack -->
      <section class="border-t border-divider/60 pt-6 print:border-black/20 print:pt-4">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent font-semibold mb-3 print:text-black">
          Governance Standards &amp; Enterprise Stack
        </h2>
        <div class="flex flex-wrap gap-1.5">
          <span class="tag tag-accent text-xs">ISO 9001:2015</span>
          <span class="tag tag-accent text-xs">ISO 14001:2015</span>
          <span class="tag tag-accent text-xs">ISO 45001:2018</span>
          <span class="tag tag-outline text-xs">Annex SL</span>
          <span class="tag tag-outline text-xs">DMR 19</span>
          <span class="tag tag-outline text-xs">OHS Act</span>
          <span class="tag tag-outline text-xs">SAP ERP</span>
          <span class="tag tag-outline text-xs">Sage Accounting</span>
          <span class="tag tag-neutral text-xs">Astro</span>
          <span class="tag tag-neutral text-xs">Next.js</span>
          <span class="tag tag-neutral text-xs">TypeScript</span>
          <span class="tag tag-neutral text-xs">Tailwind CSS</span>
        </div>
      </section>
    </article>
  </div>
</Layout>

<script>
  const printBtn = document.getElementById('print-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>

<style>
  @media print {
    /* Hide non-print chrome */
    :global(header),
    :global(footer),
    :global(#scroll-to-top),
    :global(aside),
    .no-print {
      display: none !important;
    }

    :global(body) {
      background: #ffffff !important;
      color: #111111 !important;
      font-size: 11pt !important;
      line-height: 1.4 !important;
    }

    .resume-sheet {
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 0 !important;
    }

    :global(a) {
      text-decoration: none !important;
      color: #111111 !important;
    }

    .tag {
      border: 1px solid #d1d5db !important;
      background: transparent !important;
      color: #374151 !important;
    }

    /* Avoid page-breaks inside sections */
    section, header {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    @page {
      margin: 1.2cm;
      size: A4 portrait;
    }
  }
</style>
