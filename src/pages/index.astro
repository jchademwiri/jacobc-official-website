---
import Layout from '../layouts/Layout.astro';
import FeaturedTrackRecord from '../components/FeaturedTrackRecord.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import CvDownloadButton from '../components/CvDownloadButton.astro';
import { siteConfig, heroSection, metricsStrip } from '../data/siteData';
---

<Layout
  fullTitle={siteConfig.seo.metaTitle}
  description={siteConfig.seo.metaDescription}
  includeFaqSchema={true}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-content px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="eyebrow">{heroSection.eyebrow}</p>
        <h1 class="display mt-5 text-primary">{heroSection.headline}</h1>
        <p class="mt-6 max-w-2xl text-body-lg leading-relaxed text-text-2">
          {heroSection.subheadline}
        </p>

        <div class="no-print mt-8 flex flex-wrap items-center gap-3.5">
          <CvDownloadButton label={heroSection.primaryCta.label} showIcon={true} iconSize={16} />
          <a href={heroSection.secondaryCta.href} class="btn btn-secondary">
            <span>{heroSection.secondaryCta.label}</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="/resume" class="data ml-1 text-xs font-medium text-accent hover:underline">
            View Web CV →
          </a>
        </div>
      </div>

      <!-- 4-Column Executive Metrics Strip -->
      <div class="mt-14 grid grid-cols-2 gap-4 border-t border-border pt-10 lg:grid-cols-4">
        {
          metricsStrip.map((metric) => (
            <div class="exec-card p-5">
              <p class="data text-2xl font-semibold tracking-tight text-primary sm:text-3xl">
                {metric.value}
              </p>
              <p class="mt-1.5 text-xs font-medium text-text-2 sm:text-sm">{metric.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selected Flagship Contracts (4 Cards -> /track-record) -->
  <FeaturedTrackRecord />

  <!-- Core Capabilities & Systems -->
  <CapabilitiesSection />

  <!-- Career Timeline & Credentials -->
  <ExperienceSection />

  <!-- Recruiter & GEO FAQ -->
  <FaqSection />

  <!-- Contact & Direct Inquiry -->
  <ContactSection />
</Layout>
