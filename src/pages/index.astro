---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import SectionBand from '../components/SectionBand.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import { getCollection } from 'astro:content';
import { getReadTime } from '../lib/reading-time';
import { getBlogImageUrl, PROFILE_PORTRAIT_URL } from '../lib/images';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const positions = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

const services = [
  {
    title: 'Tender Preparation Lifecycle',
    description: 'Full freelance tender lifecycle: opportunity ID, RFP analysis, compliance scheduling and competitive bid compilation.',
    href: '/services#tender-management',
  },
  {
    title: 'Website Development',
    description: 'Custom, high-performance websites and web applications built in Next.js, Astro and Tailwind CSS.',
    href: '/services#web-development',
  },
  {
    title: 'Project & AR Governance',
    description: 'Enterprise accounts receivable control (SAP & Sage), financial accuracy and end-to-end delivery coordination.',
    href: '/services#project-management',
  },
  {
    title: 'ISO Standards & Compliance',
    description: 'Applying ISO 9001, 14001 & 45001 quality frameworks to daily operational routines and bid readiness.',
    href: '/services#iso-sheq-compliance',
  },
];

const dateFormatter = new Intl.DateTimeFormat('en-ZA', { month: 'short', day: '2-digit', year: 'numeric' });
---

<Layout
  fullTitle="Jacob Chademwiri | Tender, Project & AR Manager | Centurion"
  description="Tender, project and accounts receivable manager in Centurion. Available for employment roles and freelance tender preparation and web development."
  active="home"
  schema="person"
  keywords={['tender manager', 'project manager', 'AR manager', 'tender preparation lifecycle', 'web developer', 'ISO 9001', 'ISO standards', 'SAP', 'Sage accounting', 'Centurion', 'Gauteng', 'South Africa']}
>
  <div class="grid gap-10 px-5 pb-14 pt-20 sm:px-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:px-14">
    <div>
      <p class="kicker">Jacob Chademwiri · Centurion, Gauteng</p>
      <h1 class="display mt-4 max-w-[18ch]">Tender acquisition, project delivery &amp; web development, governed by ISO quality.</h1>
      <p class="mt-6 max-w-[640px] text-body-lg text-text-2">
        Specialised in municipal tender management, enterprise AR governance (SAP &amp; Sage) and high-performance web development. Available for high-impact employment roles and freelance projects.
      </p>
      <div class="my-7 flex flex-wrap gap-2">
        <span class="tag tag-accent">Tender Management</span>
        <span class="tag tag-accent">Project Management</span>
        <span class="tag tag-accent">AR Management (SAP &amp; Sage)</span>
        <span class="tag tag-accent">Tender Lifecycle Preparation</span>
        <span class="tag tag-neutral">Web Development</span>
        <span class="tag tag-neutral">ISO Standards Compliant</span>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn btn-primary">Start a project</a>
        <a href="/services" class="btn btn-secondary">See what I do</a>
      </div>
      <p class="mt-7 flex items-baseline gap-2.5 text-meta text-text-3">
        <span class="dot" aria-hidden="true"></span>
        Available for full-time roles &amp; freelance projects. Reply within
        <span class="data">24–48</span> hours.
      </p>
    </div>
    <HeroIllustration />
  </div>

  <div id="positions" class="px-5 pb-16 pt-6 sm:px-8 md:px-14">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-7">
      <div>
        <p class="kicker">Experience</p>
        <h2 class="h2 mt-4 max-w-[28ch]">Where I'm making an impact</h2>
      </div>
      <a href="/about#experience" class="btn btn-ghost">Full timeline →</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        positions.map((position) => (
          <div class="card flex flex-col justify-between">
            <div>
              <p class="card-kicker">
                {position.data.employment} · <span class="data">{position.data.period}</span>
              </p>
              <h3 class="card-title mt-2.5 mb-1">
                <a href={`/experience/${position.id}`} class="hover:text-accent transition-colors">
                  {position.data.title}
                </a>
              </h3>
              <p class="card-meta mb-2.5">{position.data.company} · {position.data.location}</p>
              <p class="card-body">{position.data.summary}</p>
              {position.data.tags.length > 0 && (
                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  {position.data.tags.slice(0, 4).map((tag) => (
                    <span class="tag tag-outline">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-5 pt-3 border-t border-divider/40">
              <a
                href={`/experience/${position.id}`}
                class="text-accent text-[13px] font-medium inline-flex items-center gap-1 hover:underline"
              >
                <span>View role details</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <SectionBand id="services" glow="top-right">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="kicker">Services</h2>
      <a href="/services" class="btn btn-ghost">All services →</a>
    </div>
    <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <a href={service.href} class="group block border-t border-divider pt-5">
            <h3 class="h3 mb-2.5 group-hover:text-accent">{service.title}</h3>
            <p class="text-body text-text-2">{service.description}</p>
          </a>
        ))
      }
    </div>
  </SectionBand>

  <div
    id="about"
    class="grid gap-8 px-5 py-16 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:gap-12 md:px-14"
  >
    <figure class="m-0">
      <img
        src={PROFILE_PORTRAIT_URL}
        alt="Jacob Chademwiri, Tender and Project Manager, ISO Implementation Lead, AR Manager, Web Developer"
        width="640"
        height="800"
        class="aspect-[4/5] w-full rounded-xl object-cover"
        loading="lazy"
      />
    </figure>
    <div>
      <p class="kicker">About</p>
      <h2 class="h2 mt-4 mb-5 max-w-[26ch]">
        I work both sides of the contract: winning it, then delivering it.
      </h2>
      <p class="mb-6 max-w-[48ch] text-body text-text-2">
        Based in Centurion, Gauteng, I manage tender submissions, enterprise accounts receivable in SAP and Sage, and modern web development, applying ISO quality frameworks across operational and digital delivery.
      </p>
      <a href="/about" class="btn btn-secondary">More about me</a>
    </div>
  </div>

  <div id="blog-preview" class="px-5 pb-16 pt-6 sm:px-8 md:px-14">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="kicker">From the blog</h2>
      <a href="/blog" class="btn btn-ghost">All posts →</a>
    </div>
    <div class="mt-6 grid items-start gap-5 md:grid-cols-3">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}`} class="card group block overflow-hidden p-0">
            <img
              src={getBlogImageUrl(post.data.cover)}
              alt={post.data.title}
              width="640"
              height="400"
              class="aspect-[16/10] w-full object-cover"
              loading="lazy"
            />
            <div class="px-4 py-4">
              <p class="card-kicker">{post.data.category}</p>
              <h3 class="card-title my-2 group-hover:text-accent">{post.data.title}</h3>
              <p class="card-body mb-2.5">{post.data.excerpt}</p>
              <p class="card-meta">
                {dateFormatter.format(post.data.date)} · {getReadTime(post.body ?? '')}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <ContactBand
    headingLevel={2}
    trustLine="24–48hr reply · Free first assessment · Tailored solutions"
  />
</Layout>
