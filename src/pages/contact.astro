---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/site';

const contactMethods = [
  { label: 'Email', value: CONTACT_EMAIL, href: CONTACT_MAILTO },
  { label: 'GitHub', value: 'github.com/jchademwiri', href: 'https://github.com/jchademwiri' },
  { label: 'LinkedIn', value: 'linkedin.com/in/jchademwiri', href: 'https://linkedin.com/in/jchademwiri' },
];

const expectations = [
  'Response within 24–48 hours',
  'Free initial assessment',
  'Tailored solutions, not templates',
];
---

<Layout
  title="Contact"
  description="Get in touch about tender management, project delivery or a new website."
  active="contact"
>
  <div class="px-5 pb-14 pt-16 sm:px-8 md:px-14 md:pb-14 md:pt-20">
    <span class="kicker">Contact</span>
    <h1 class="max-w-[18ch] text-[32px] sm:text-[42px] md:text-[48px]">
      Let's talk about your next project.
    </h1>
    <p class="mt-5 max-w-[620px] text-base leading-[1.65]" style="color: color-mix(in srgb, var(--color-text) 82%, transparent)">
      Whether it's a tender submission, an ISO/SHEQ rollout, project coordination or a new website — reach out directly and I'll come back to you within 24–48 hours.
    </p>
  </div>

  <div class="grid gap-6 border-t border-divider px-5 py-12 sm:px-8 md:grid-cols-2 md:px-14">
    <div class="card">
      <p class="card-kicker mb-3">Get in touch</p>
      <div class="flex flex-col gap-4">
        {
          contactMethods.map((method) => (
            <div>
              <p class="card-meta mb-1">{method.label}</p>
              <a href={method.href} class="text-accent">
                {method.value}
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="card">
      <p class="card-kicker mb-3">What to expect</p>
      <ul class="flex flex-col gap-3">
        {
          expectations.map((item) => (
            <li class="card-body flex items-baseline gap-2">
              <span class="text-accent">●</span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="flex flex-col gap-3 px-5 pb-16 sm:flex-row sm:px-8 md:px-14 [&_a]:text-center sm:[&_a]:text-left">
    <a href={CONTACT_MAILTO} class="btn btn-primary">Schedule Consultation</a>
    <a href="/services" class="btn btn-secondary">View Our Services</a>
  </div>
</Layout>
