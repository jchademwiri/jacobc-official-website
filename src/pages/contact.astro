---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/site';
import { looksAutomated, validateContact, FIELDS, type Field } from '../lib/contact';
import { sendContactEmail } from '../lib/send-contact-email';

const contactMethods = [
  { label: 'Email', value: CONTACT_EMAIL, href: CONTACT_MAILTO },
  { label: 'GitHub', value: 'github.com/jchademwiri', href: 'https://github.com/jchademwiri' },
  { label: 'LinkedIn', value: 'linkedin.com/in/jchademwiri', href: 'https://linkedin.com/in/jchademwiri' },
];

const expectations = [
  'A reply within 24–48 hours',
  'A free first assessment of the work',
  'Tailored solutions, not templates',
];

const json = (body: unknown, status: number) =>
  new Response(JSON.stringify(body), {
    status,
    headers: { 'Content-Type': 'application/json' },
  });

let errors: Partial<Record<Field, string>> = {};
let values: Partial<Record<Field, string>> = {};
let sent = false;
let failed = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const wantsJson = Astro.request.headers.get('accept')?.includes('application/json') ?? false;

  // Accept-and-drop: a bot that gets an error learns how to get past it.
  if (looksAutomated(form)) {
    if (wantsJson) return json({ ok: true }, 200);
    sent = true;
  } else {
    const result = validateContact(form);

    if (!result.ok) {
      if (wantsJson) return json({ ok: false, errors: result.errors }, 422);
      errors = result.errors;
      for (const field of FIELDS) {
        const raw = form.get(field);
        if (typeof raw === 'string') values[field] = raw;
      }
    } else {
      try {
        await sendContactEmail(result.data);
        if (wantsJson) return json({ ok: true }, 200);
        sent = true;
      } catch (error) {
        console.error('[contact] send failed', error);
        if (wantsJson) return json({ ok: false }, 500);
        failed = true;
        for (const field of FIELDS) {
          const raw = form.get(field);
          if (typeof raw === 'string') values[field] = raw;
        }
      }
    }
  }
}
---

<Layout
  title="Contact"
  description="Get in touch about tender management, project delivery or a new website."
  active="contact"
>
  <div class="px-5 pb-10 pt-16 sm:px-8 md:px-14 md:pt-20">
    <p class="kicker">Contact</p>
    <h1 class="h1 max-w-[18ch]">Let's talk about your next project.</h1>
    <p class="mt-5 max-w-[620px] text-body-lg text-text-2">
      Whether it's a tender submission, an ISO/SHEQ rollout, project coordination or a new website,
      tell me what you're working on and I'll come back to you within 24–48 hours.
    </p>
  </div>

  <div
    class="grid gap-10 border-t border-divider px-5 py-12 sm:px-8 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-14 md:px-14"
  >
    <div id="form">
      <h2 class="h3 mb-6">Send a message</h2>
      {
        sent ? (
          <div class="form-success" tabindex="-1">
            <p class="form-success-title">Message sent</p>
            <p class="form-success-body">
              Thanks — I read everything myself and reply within 24–48 hours.
            </p>
          </div>
        ) : (
          <ContactForm errors={errors} values={values} failed={failed} />
        )
      }
    </div>

    <div class="flex flex-col gap-6">
      <div class="card">
        <h2 class="card-kicker mb-3">Reach me directly</h2>
        <div class="flex flex-col gap-4">
          {
            contactMethods.map((method) => (
              <div>
                <p class="card-meta mb-1">{method.label}</p>
                <a href={method.href} class="text-accent">
                  {method.value}
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <div class="card">
        <h2 class="card-kicker mb-3">What to expect</h2>
        <ul class="flex flex-col gap-3">
          {
            expectations.map((item) => (
              <li class="card-body flex items-baseline gap-2.5">
                <span class="dot" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Layout>
