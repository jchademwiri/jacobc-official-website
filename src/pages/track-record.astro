---
import Layout from '../layouts/Layout.astro';
import ContractPortfolio from '../components/ContractPortfolio.astro';
import { siteConfig, contractPortfolio } from '../data/siteData';

const entitySummary = [
  {
    name: 'City of Tshwane',
    count: contractPortfolio.filter((c) => c.entity === 'City of Tshwane').length,
  },
  {
    name: 'City of Ekurhuleni',
    count: contractPortfolio.filter((c) => c.entity === 'City of Ekurhuleni').length,
  },
  {
    name: 'Pikitup Johannesburg',
    count: contractPortfolio.filter((c) => c.entity === 'Pikitup Johannesburg').length,
  },
  {
    name: 'Msunduzi Municipality',
    count: contractPortfolio.filter((c) => c.entity === 'Msunduzi Municipality').length,
  },
];
---

<Layout
  title="Municipal Contract Track Record (10+ Contracts)"
  description="Complete verified portfolio of 10+ multi-year municipal contracts managed by Jacob Chademwiri across City of Tshwane, City of Ekurhuleni, Pikitup Johannesburg, and Msunduzi Municipality."
>
  <!-- Page Header -->
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-content px-5 sm:px-8">
      <a href="/" class="data inline-flex items-center gap-1.5 text-xs font-medium text-accent hover:underline">
        <span aria-hidden="true">←</span>
        <span>Back to Overview</span>
      </a>

      <div class="mt-6 max-w-3xl">
        <p class="eyebrow">Full Verified Portfolio</p>
        <h1 class="display mt-4 text-primary">Municipal Contract Track Record</h1>
        <p class="mt-4 text-body-lg text-text-2">
          All {contractPortfolio.length} multi-year public-sector contracts I have priced, won, inherited, and managed across four South African municipalities. Filter by category or entity below.
        </p>
      </div>

      <!-- Entity Breakdown Strip -->
      <div class="mt-8 grid grid-cols-2 gap-3.5 lg:grid-cols-4">
        {
          entitySummary.map((entity) => (
            <div class="exec-card p-4">
              <p class="data text-2xl font-semibold text-primary">{entity.count}</p>
              <p class="mt-1 text-xs font-medium text-text-2">{entity.name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Full Interactive 17-Contract Portfolio -->
  <ContractPortfolio />

  <!-- Bottom Action Strip -->
  <section class="no-print border-t border-border py-14">
    <div class="mx-auto flex max-w-content flex-col items-start justify-between gap-5 px-5 sm:flex-row sm:items-center sm:px-8">
      <div>
        <h2 class="h3 text-primary">Need the full commercial summary for your hiring team?</h2>
        <p class="mt-1 text-sm text-text-2">
          Download the v4 executive CV or reach out directly to discuss Procurement, Tender, or Contract Management roles.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={siteConfig.cvPath} download class="btn btn-primary text-xs">
          Download CV (DOCX)
        </a>
        <a href="/#contact" class="btn btn-secondary text-xs">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
