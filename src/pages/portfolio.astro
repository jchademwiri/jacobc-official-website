---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('portfolio')).sort((a, b) => b.data.year.localeCompare(a.data.year));

const categoryLabels: Record<string, string> = {
  website: 'Website',
  app: 'Web App',
  project: 'Project',
  tender: 'Tender',
};

const filters = [
  { key: 'all', label: 'All' },
  { key: 'website', label: 'Website Development' },
  { key: 'app', label: 'Web Apps' },
  { key: 'project', label: 'Project Management' },
  { key: 'tender', label: 'Tender Preparations' },
];
---

<Layout
  title="Portfolio"
  description="Websites built, projects managed and tenders delivered."
  active="portfolio"
>
  <div class="px-5 pb-6 pt-14 sm:px-8 md:px-14">
    <span class="kicker">Portfolio</span>
    <h1 class="mb-3 text-[38px]">Evidence of the work.</h1>
    <p class="max-w-[56ch] text-[15px]" style="color: color-mix(in srgb, var(--color-text) 78%, transparent)">
      A record of websites built, projects managed and tenders delivered.
    </p>
    <div class="seg mt-6 inline-flex" id="portfolio-filter">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            aria-pressed={index === 0 ? 'true' : 'false'}
            class:list={['seg-opt', index === 0 && 'is-active']}
            data-filter={filter.key}
          >
            {filter.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="grid gap-5 px-5 pb-16 pt-4 sm:px-8 md:grid-cols-3 md:px-14" id="portfolio-grid">
    {
      items.map((item) => (
        <div class="card flex flex-col overflow-hidden p-0" data-category={item.data.category}>
          <img
            src={`https://picsum.photos/seed/${item.data.cover}/640/400`}
            alt=""
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col px-4 py-3.5">
            <p class="card-kicker">{categoryLabels[item.data.category]}</p>
            <h4 class="card-title my-1.5">{item.data.title}</h4>
            <p class="card-meta mb-2">
              {item.data.client} · {item.data.year}
            </p>
            <p class="card-body">{item.data.excerpt}</p>
            {item.data.outcome && (
              <p class="mt-2 text-[13px] text-accent">{item.data.outcome}</p>
            )}
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.data.tags.map((tag) => (
                <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
              ))}
            </div>
            {item.data.link && item.data.link !== '#' && (
              <a href={item.data.link} target="_blank" rel="noopener noreferrer" class="mt-3 text-sm text-accent">
                View site →
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Layout>

<script>
  const container = document.getElementById('portfolio-filter');
  const cards = document.querySelectorAll<HTMLElement>('#portfolio-grid [data-category]');

  container?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button) return;

    container.querySelectorAll<HTMLButtonElement>('.seg-opt').forEach((opt) => {
      opt.classList.remove('is-active');
      opt.setAttribute('aria-pressed', 'false');
    });
    button.classList.add('is-active');
    button.setAttribute('aria-pressed', 'true');

    const filter = button.dataset.filter;
    cards.forEach((card) => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.style.display = show ? '' : 'none';
    });
  });
</script>
