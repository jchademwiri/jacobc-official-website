---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import { getCollection } from 'astro:content';
import { getPortfolioImageUrl } from '../lib/images';

const categoryPriority: Record<string, number> = {
  tender: 1,
  project: 2,
  app: 3,
  website: 4,
};

const items = (await getCollection('portfolio', ({ data }) => !data.draft)).sort((a, b) => {
  const prioDiff = (categoryPriority[a.data.category] ?? 9) - (categoryPriority[b.data.category] ?? 9);
  if (prioDiff !== 0) return prioDiff;
  return b.data.year.localeCompare(a.data.year);
});

const categoryLabels: Record<string, string> = {
  tender: 'Awarded Tender',
  project: 'Project & ISO Delivery',
  app: 'Complementary Web App',
  website: 'Complementary Website',
};

const filters = [
  { key: 'all', label: 'All Work', href: '/portfolio' },
  { key: 'tender', label: 'Awarded Tenders', href: '/portfolio/category/tender' },
  { key: 'project', label: 'Project & ISO Delivery', href: '/portfolio/category/project' },
  { key: 'app', label: 'Bid-Tech & Web Apps', href: '/portfolio/category/app' },
  { key: 'website', label: 'Contractor Websites', href: '/portfolio/category/website' },
];
---

<Layout
  title="Awarded Tenders, Delivered Projects & Web Portfolio"
  description="Track record of awarded 3-year City of Tshwane municipal tenders, ISO 9001/14001/45001 implementation, managed contracts, and complementary web & SaaS platforms."
  active="portfolio"
  keywords={[
    'awarded tenders',
    'City of Tshwane tenders',
    'tender manager portfolio',
    'project management',
    'ISO 9001 implementation',
    'TenderTrack360',
    'contractor web development',
    'Centurion',
    'Gauteng',
  ]}
>
  <div class="px-5 pb-6 pt-16 sm:px-8 md:px-14">
    <p class="kicker">Track Record &amp; Proof of Work</p>
    <h1 class="h1 mt-4 mb-4">Awarded tenders, delivered contracts &amp; digital systems.</h1>
    <p class="max-w-[60ch] text-body-lg text-text-2">
      A verifiable record of multi-year municipal tenders won, contracts coordinated and billed in SAP &amp; Sage, ISO 9001/14001/45001 systems rolled out, and complementary web platforms engineered.
    </p>
    <nav class="seg mt-7" id="portfolio-filter" aria-label="Filter portfolio by category">
      {
        filters.map((filter, index) => (
          <a
            href={filter.href}
            aria-current={index === 0 ? 'page' : undefined}
            class:list={['seg-opt', index === 0 && 'is-active']}
            data-filter={filter.key}
          >
            {filter.label}
          </a>
        ))
      }
    </nav>
    <p id="portfolio-filter-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>

  <div
    class="grid gap-5 px-5 pb-16 pt-5 sm:px-8 md:grid-cols-2 lg:grid-cols-3 md:px-14"
    id="portfolio-grid"
  >
    {
      items.map((item) => (
        <a
          href={`/portfolio/${item.id}`}
          class="card card-interactive group flex flex-col overflow-hidden p-0"
          data-category={item.data.category}
        >
          <img
            src={getPortfolioImageUrl(item.data.cover)}
            alt={`${item.data.title} — ${item.data.client}`}
            width="640"
            height="400"
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col px-4 py-4">
            <p class="card-kicker">{categoryLabels[item.data.category]}</p>
            <h2 class="card-title my-2 group-hover:text-accent">{item.data.title}</h2>
            <p class="card-meta mb-2.5">
              {item.data.client} · <span class="data">{item.data.year}</span>
            </p>
            <p class="card-body">{item.data.excerpt}</p>
            {item.data.outcome && (
              <p class="data mt-3 text-meta font-medium text-accent">{item.data.outcome}</p>
            )}
            <div class="mt-auto flex flex-wrap gap-1.5 pt-3.5">
              {item.data.tags.map((tag) => (
                <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <ContactBand
    heading="Need a Tender Manager who delivers results like these?"
    body="Whether you are hiring for a full-time Tender & Project Management role or need help winning and running a major contract, let's talk."
  />
</Layout>

<script>
  import { initFilter } from '../scripts/filter';
  initFilter({ containerId: 'portfolio-filter', gridId: 'portfolio-grid', attribute: 'category' });
</script>
