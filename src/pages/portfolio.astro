---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPortfolioImageUrl } from '../lib/images';

const items = (await getCollection('portfolio')).sort((a, b) => b.data.year.localeCompare(a.data.year));

const categoryLabels: Record<string, string> = {
  website: 'Website',
  app: 'Web App',
  project: 'Project',
  tender: 'Tender',
};

const filters = [
  { key: 'all', label: 'All', href: '/portfolio' },
  { key: 'website', label: 'Website Development', href: '/portfolio/category/website' },
  { key: 'app', label: 'Web Apps', href: '/portfolio/category/app' },
  { key: 'project', label: 'Project Management', href: '/portfolio/category/project' },
  { key: 'tender', label: 'Tender Preparations', href: '/portfolio/category/tender' },
];
---

<Layout
  title="Portfolio"
  description="Websites built, projects managed and tenders delivered across Gauteng and beyond."
  active="portfolio"
>
  <div class="px-5 pb-6 pt-16 sm:px-8 md:px-14">
    <p class="kicker">Portfolio</p>
    <h1 class="h1 mt-4 mb-4">Evidence of the work.</h1>
    <p class="max-w-[56ch] text-body-lg text-text-2">
      A record of websites built, projects managed and tenders delivered.
    </p>
    <div class="seg mt-7" id="portfolio-filter">
      {
        filters.map((filter, index) => (
          <a
            href={filter.href}
            aria-current={index === 0 ? 'true' : undefined}
            class:list={['seg-opt', index === 0 && 'is-active']}
            data-filter={filter.key}
          >
            {filter.label}
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="grid gap-5 px-5 pb-16 pt-5 sm:px-8 md:grid-cols-2 lg:grid-cols-3 md:px-14"
    id="portfolio-grid"
  >
    {
      items.map((item) => (
        <a
          href={`/portfolio/${item.id}`}
          class="card group flex flex-col overflow-hidden p-0"
          data-category={item.data.category}
        >
          <img
            src={getPortfolioImageUrl(item.data.cover)}
            alt={item.data.title}
            width="640"
            height="400"
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col px-4 py-4">
            <p class="card-kicker">{categoryLabels[item.data.category]}</p>
            <h2 class="card-title my-2 group-hover:text-accent">{item.data.title}</h2>
            <p class="card-meta mb-2.5">
              {item.data.client} · <span class="data">{item.data.year}</span>
            </p>
            <p class="card-body">{item.data.excerpt}</p>
            {item.data.outcome && (
              <p class="data mt-3 text-meta text-accent">{item.data.outcome}</p>
            )}
            <div class="mt-auto flex flex-wrap gap-1.5 pt-3.5">
              {item.data.tags.map((tag) => (
                <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Layout>

<script>
  import { initFilter } from '../scripts/filter';
  initFilter({ containerId: 'portfolio-filter', gridId: 'portfolio-grid', attribute: 'category' });
</script>
