---
import Layout from '../layouts/Layout.astro';
import NotFoundIllustration from '../components/NotFoundIllustration.astro';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <div class="flex min-h-[65vh] flex-col items-center justify-center px-5 py-20 text-center sm:px-8 md:px-14">
    <NotFoundIllustration />
    <span class="mb-1 text-xs font-medium uppercase tracking-[0.08em] text-accent">404</span>
    <h1 class="mb-4 max-w-[18ch] text-[32px] sm:text-[42px]">This page took a wrong turn.</h1>
    <p class="mb-7 max-w-[48ch] text-[15px]" style="color: color-mix(in srgb, var(--color-text) 78%, transparent)">
      The link that brought you here is broken, or the page has moved. Try one of these instead.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/blog" class="btn btn-secondary">Read the Blog</a>
      <a href="/portfolio" class="btn btn-secondary">View Portfolio</a>
      <a href="/contact" class="btn btn-secondary">Contact Me</a>
    </div>
  </div>
</Layout>
