---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist." noindex>
  <div class="flex min-h-[60vh] flex-col items-start justify-center px-5 py-20 sm:px-8 md:px-14">
    <p class="kicker">Error <span class="data">404</span></p>
    <h1 class="h1 mt-4 mb-4 max-w-[16ch]">This page doesn't exist.</h1>
    <p class="mb-8 max-w-[52ch] text-body-lg text-text-2">
      The page you're looking for may have moved, or never existed. Try one of these instead.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/portfolio" class="btn btn-secondary">See the work</a>
      <a href="/blog" class="btn btn-secondary">Read the blog</a>
    </div>
  </div>
</Layout>
