---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteData';
---

<Layout
  title="Page Not Found"
  description={`The requested page could not be found on ${siteConfig.name}'s executive portfolio.`}
  noindex={true}
>
  <section class="mx-auto flex max-w-content flex-col items-start px-5 py-24 sm:px-8 sm:py-32">
    <p class="eyebrow">404 &middot; Not Found</p>
    <h1 class="display mt-4 text-primary">This page has moved or no longer exists.</h1>
    <p class="mt-4 max-w-xl text-body-lg text-text-2">
      jacobc.co.za has been streamlined into a focused executive portfolio for Procurement, Tender &amp; Contract Management.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Return to Portfolio</a>
      <a href={siteConfig.cvPath} download class="btn btn-secondary">Download CV (PDF)</a>
    </div>
  </section>
</Layout>
