---
import Layout from '../layouts/Layout.astro';
import NotFoundIllustration from '../components/NotFoundIllustration.astro';
---

<Layout title="Page not found" description="This page doesn't exist." noindex={true}>
  <div class="flex min-h-[65vh] flex-col items-center justify-center px-5 py-20 text-center sm:px-8 md:px-14">
    <NotFoundIllustration />
    <p class="data mb-2 text-label font-medium uppercase tracking-[0.08em] text-accent">Error 404</p>
    <h1 class="h1 mb-4 max-w-[18ch]">This page took a wrong turn.</h1>
    <p class="mb-7 max-w-[48ch] text-body text-text-2">
      The link that brought you here is broken, or the page has moved. Try one of these instead.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/portfolio" class="btn btn-secondary">View Portfolio</a>
      <a href="/blog" class="btn btn-secondary">Read the Blog</a>
      <a href="/contact" class="btn btn-secondary">Start a project</a>
    </div>
  </div>
</Layout>
