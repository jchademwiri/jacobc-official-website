---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <div class="flex min-h-[60vh] flex-col items-start justify-center px-5 py-20 sm:px-8 md:px-14">
    <span class="kicker">404</span>
    <h1 class="mb-4 max-w-[16ch] text-[32px] sm:text-[42px]">This page doesn't exist.</h1>
    <p class="mb-7 max-w-[52ch] text-[15px]" style="color: color-mix(in srgb, var(--color-text) 78%, transparent)">
      The page you're looking for may have moved or never existed. Try one of the links below.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/blog" class="btn btn-secondary">Read the Blog</a>
      <a href="/portfolio" class="btn btn-secondary">View Portfolio</a>
    </div>
  </div>
</Layout>
