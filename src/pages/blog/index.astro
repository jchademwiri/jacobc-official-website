---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReadTime } from '../../lib/reading-time';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const filters = [
  { key: 'all', label: 'All', href: '/blog' },
  { key: 'tendering', label: 'Tendering', href: '/blog/track/tendering' },
  { key: 'iso', label: 'ISO / SHEQ', href: '/blog/track/iso' },
  { key: 'dev', label: 'Web Dev', href: '/blog/track/dev' },
];

const dateFormatter = new Intl.DateTimeFormat('en-ZA', { month: 'short', day: '2-digit', year: 'numeric' });
---

<Layout
  title="Blog"
  description="Field notes from running bids, building ISO management systems and shipping websites."
  active="blog"
>
  <div class="px-5 pb-6 pt-16 sm:px-8 md:px-14">
    <p class="kicker">Blog</p>
    <h1 class="h1 mt-4 mb-4">Notes on tenders, compliance &amp; the web.</h1>
    <p class="max-w-[56ch] text-body-lg text-text-2">
      Field notes from running bids, building ISO management systems and shipping websites.
    </p>
    <div class="seg mt-7" id="blog-filter">
      {
        filters.map((filter, index) => (
          <a
            href={filter.href}
            aria-current={index === 0 ? 'true' : undefined}
            class:list={['seg-opt', index === 0 && 'is-active']}
            data-filter={filter.key}
          >
            {filter.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="grid gap-5 px-5 pb-16 pt-5 sm:px-8 md:grid-cols-2 lg:grid-cols-3 md:px-14" id="blog-grid">
    {
      posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="card group flex flex-col overflow-hidden p-0"
          data-track={post.data.track}
        >
          <img
            src={`https://picsum.photos/seed/${post.data.cover}/640/400`}
            alt=""
            width="640"
            height="400"
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col px-4 py-4">
            <p class="card-kicker">{post.data.category}</p>
            <h2 class="card-title my-2 group-hover:text-accent">{post.data.title}</h2>
            <p class="card-body">{post.data.excerpt}</p>
            <p class="card-meta mt-auto pt-3">
              {dateFormatter.format(post.data.date)} · {getReadTime(post.body ?? '')}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</Layout>

<script>
  import { initFilter } from '../../scripts/filter';
  initFilter({ containerId: 'blog-filter', gridId: 'blog-grid', attribute: 'track' });
</script>
