---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
---

<Layout title={post.data.title} description={post.data.excerpt} maxWidth="narrow" footerVariant="post">
  <div class="px-5 pt-12 sm:px-8 md:px-14">
    <span class="kicker">{post.data.category} · {dateFormatter.format(post.data.date)} · {post.data.readTime}</span>
    <h1 class="max-w-[22ch] text-[28px] leading-[1.25] sm:text-[36px]">{post.data.title}</h1>
  </div>

  <figure class="my-8 px-5 sm:px-8 md:px-14">
    <img
      src={`https://picsum.photos/seed/${post.data.cover}/1200/675`}
      alt=""
      class="aspect-[16/9] w-full rounded-[10px] object-cover"
    />
  </figure>

  <div class="max-w-[640px] px-5 pb-14 sm:px-8 md:px-14 prose-post">
    <Content />
    <hr class="rule-fade my-8" />
    <div class="flex flex-wrap gap-2">
      {
        post.data.tags.map((tag) => (
          <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .prose-post :global(p) {
    margin: 0 0 20px;
    font-size: 15.5px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
  }

  .prose-post :global(p:first-of-type) {
    font-size: 16px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .prose-post :global(h2) {
    margin: 32px 0 10px;
    font-size: 19px;
  }
</style>
