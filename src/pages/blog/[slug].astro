---
import Layout from '../../layouts/Layout.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { getCollection, render } from 'astro:content';
import { getReadTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-ZA', { month: 'short', day: '2-digit', year: 'numeric' });
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  maxWidth="narrow"
  footerVariant="post"
  active="blog"
  ogType="article"
  publishedTime={post.data.date}
  tags={post.data.tags.map((tag) => tag.label)}
  breadcrumb={[
    { name: 'Blog', href: '/blog' },
    { name: post.data.title, href: `/blog/${post.id}` },
  ]}
>
  <div class="px-5 pt-14 sm:px-8 md:px-14">
    <p class="kicker">
      {post.data.category} ·
      <time class="data" datetime={post.data.date.toISOString()}>
        {dateFormatter.format(post.data.date)}
      </time>
      · <span class="data">{getReadTime(post.body ?? '')}</span>
    </p>
    <h1 class="h1 mt-4 max-w-[22ch]">{post.data.title}</h1>
  </div>

  <figure class="my-8 px-5 sm:px-8 md:px-14">
    <img
      src={`https://picsum.photos/seed/${post.data.cover}/1200/675`}
      alt=""
      width="1200"
      height="675"
      fetchpriority="high"
      class="aspect-[16/9] w-full rounded-[10px] object-cover"
    />
  </figure>

  <div class="prose-post px-5 pb-14 sm:px-8 md:px-14">
    <Content />
    <hr class="rule-fade my-8" />
    <div class="flex flex-wrap gap-2">
      {
        post.data.tags.map((tag) => (
          <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
        ))
      }
    </div>
  </div>

  <ScrollToTop />
</Layout>
