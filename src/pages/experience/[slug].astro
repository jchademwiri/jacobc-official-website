---
import Layout from '../../layouts/Layout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('experience');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout
  title={`${item.data.company} | ${item.data.title}`}
  description={item.data.summary}
  maxWidth="narrow"
  active="about"
  schema="person"
  breadcrumb={[
    { name: 'About', href: '/about#experience' },
    { name: item.data.company, href: `/experience/${item.id}` },
  ]}
>
  <div class="px-5 pt-14 sm:px-8 md:px-14">
    <p class="kicker">
      {item.data.company} · <span class="data">{item.data.period}</span>
    </p>
    <h1 class="h1 mt-4 max-w-[24ch]">{item.data.title}</h1>
    <p class="mt-3 text-meta text-text-3">{item.data.meta}</p>
  </div>

  <div class="my-8 border-y border-divider px-5 py-6 sm:px-8 md:px-14 bg-surface/30">
    <div class="grid grid-cols-2 gap-5 sm:gap-6">
      <div>
        <p class="card-kicker mb-1">Company</p>
        <p class="text-[14px] font-medium text-text">{item.data.company}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Period</p>
        <p class="data text-[14px] text-accent font-medium">{item.data.period}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Employment</p>
        <p class="text-[14px] text-text-2">{item.data.employment}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Location</p>
        <p class="text-[14px] text-text-2">{item.data.location}</p>
      </div>
    </div>
  </div>

  <!-- Career Progression Timeline (LinkedIn style) -->
  {
    item.data.progression && item.data.progression.length > 0 && (
      <div class="my-10 border-b border-divider pb-12 px-5 sm:px-8 md:px-14">
        <div class="flex items-center gap-2 mb-2">
          <span class="dot" aria-hidden="true"></span>
          <p class="font-mono text-[11px] uppercase tracking-widest text-accent font-medium">
            Career Progression &amp; Promotions
          </p>
        </div>
        <h2 class="h2 mb-2 max-w-[24ch]">Growth &amp; Milestones at {item.data.company}</h2>
        <p class="text-meta text-text-3 mb-8">
          {item.data.totalDuration || item.data.period} · {item.data.employment} · {item.data.location}
        </p>

        <div class="relative pl-6 sm:pl-8 border-l-2 border-divider ml-2 sm:ml-3 space-y-7">
          {item.data.progression.map((step) => (
            <div class="relative group">
              <!-- Timeline node dot -->
              <span
                class:list={[
                  'absolute -left-[31px] sm:-left-[39px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full border-2 bg-surface transition-colors',
                  step.current
                    ? 'border-accent bg-accent/20'
                    : 'border-divider group-hover:border-accent/60',
                ]}
              >
                {step.current && <span class="h-1.5 w-1.5 rounded-full bg-accent" />}
              </span>

              <div class="rounded-xl border border-edge bg-surface/70 p-5 sm:p-6 backdrop-blur-xs transition-all hover:border-accent/40">
                <div class="border-b border-divider/40 pb-3 mb-3.5">
                  <h3 class="text-base sm:text-[17px] font-semibold text-text tracking-tight">
                    {step.title}
                  </h3>
                  <p class="mt-1 flex items-center gap-1.5 font-mono text-xs text-accent">
                    <span>{step.period}</span>
                    {step.duration && (
                      <span class="text-text-3 font-sans">· {step.duration}</span>
                    )}
                  </p>
                </div>

                {step.summary && (
                  <p class="text-[14px] leading-relaxed text-text-2 mb-3.5">
                    {step.summary}
                  </p>
                )}

                {step.highlights && step.highlights.length > 0 && (
                  <ul class="mb-4 space-y-2 text-[13px] leading-relaxed text-text-2">
                    {step.highlights.map((h) => (
                      <li class="flex items-baseline gap-2">
                        <span class="text-accent text-xs">▹</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {step.skills && step.skills.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1.5 pt-3 border-t border-divider/30">
                    <span class="text-[11px] font-medium text-text-3 mr-1 flex items-center gap-1">
                      <span>◆</span>
                      <span>Skills:</span>
                    </span>
                    {step.skills.map((skill) => (
                      <span class="tag tag-neutral text-[11px] py-0.5 px-2">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <div class="prose-post px-5 pb-14 sm:px-8 md:px-14">
    <Content />

    <hr class="rule-fade my-10" />

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-1.5">
        {
          item.data.tags.map((tag) => (
            <span class="tag tag-accent">{tag}</span>
          ))
        }
      </div>

      <a href="/about#experience" class="btn btn-secondary no-underline">
        ← Back to About
      </a>
    </div>
  </div>

  <ContactBand heading="Interested in discussing a project or role?" />
</Layout>
