---
import Layout from '../../layouts/Layout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('experience');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout
  title={`${item.data.company} | ${item.data.title}`}
  description={item.data.summary}
  maxWidth="narrow"
  active="about"
  schema="person"
  breadcrumb={[
    { name: 'About', href: '/about#experience' },
    { name: item.data.company, href: `/experience/${item.id}` },
  ]}
>
  <div class="px-5 pt-14 sm:px-8 md:px-14">
    <p class="kicker">
      {item.data.company} · <span class="data">{item.data.period}</span>
    </p>
    <h1 class="h1 mt-4 max-w-[24ch]">{item.data.title}</h1>
    <p class="mt-3 text-meta text-text-3">{item.data.meta}</p>
  </div>

  <div class="my-8 border-y border-divider px-5 py-6 sm:px-8 md:px-14 bg-surface/30">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div>
        <p class="card-kicker mb-1">Company</p>
        <p class="text-[14px] font-medium text-text">{item.data.company}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Period</p>
        <p class="data text-[14px] text-accent font-medium">{item.data.period}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Employment</p>
        <p class="text-[14px] text-text-2">{item.data.employment}</p>
      </div>
      <div>
        <p class="card-kicker mb-1">Location</p>
        <p class="text-[14px] text-text-2">{item.data.location}</p>
      </div>
    </div>
  </div>

  <div class="prose-post px-5 pb-14 sm:px-8 md:px-14">
    <Content />

    <hr class="rule-fade my-10" />

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-1.5">
        {
          item.data.tags.map((tag) => (
            <span class="tag tag-accent">{tag}</span>
          ))
        }
      </div>

      <a href="/about#experience" class="btn btn-secondary">
        ← Back to About
      </a>
    </div>
  </div>

  <ContactBand heading="Interested in discussing a project or role?" />
</Layout>
