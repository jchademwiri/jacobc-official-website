---
import Layout from '../../layouts/Layout.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const categoryLabels: Record<string, string> = {
  website: 'Website',
  app: 'Web App',
  project: 'Project',
  tender: 'Tender',
};
---

<Layout title={item.data.title} description={item.data.excerpt} maxWidth="narrow" footerVariant="portfolio">
  <div class="px-5 pt-12 sm:px-8 md:px-14">
    <span class="kicker">{categoryLabels[item.data.category]} · {item.data.client} · {item.data.year}</span>
    <h1 class="max-w-[22ch] text-[28px] leading-[1.25] sm:text-[36px]">{item.data.title}</h1>
  </div>

  <figure class="my-8 px-5 sm:px-8 md:px-14">
    <img
      src={`https://picsum.photos/seed/${item.data.cover}/1200/675`}
      alt=""
      class="aspect-[16/9] w-full rounded-[10px] object-cover"
    />
  </figure>

  <div class="px-5 pb-14 sm:px-8 md:px-14 prose-post">
    <div class="mb-6 flex flex-wrap gap-x-8 gap-y-3">
      <div>
        <p class="card-meta mb-1">Role</p>
        <p class="text-[15px]">{item.data.role}</p>
      </div>
      {
        item.data.outcome && (
          <div>
            <p class="card-meta mb-1">Outcome</p>
            <p class="text-[15px] text-accent">{item.data.outcome}</p>
          </div>
        )
      }
    </div>

    <Content />

    <hr class="rule-fade my-8" />

    <div class="flex flex-wrap items-center gap-2">
      {
        item.data.tags.map((tag) => (
          <span class={tag.accent ? 'tag tag-accent' : 'tag tag-neutral'}>{tag.label}</span>
        ))
      }
      {
        item.data.link && item.data.link !== '#' && (
          <a href={item.data.link} target="_blank" rel="noopener noreferrer" class="ml-auto text-sm text-accent">
            View site →
          </a>
        )
      }
    </div>
  </div>

  <ScrollToTop />
</Layout>

<style>
  .prose-post :global(p) {
    margin: 0 0 20px;
    font-size: 15.5px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
  }

  .prose-post :global(p:first-of-type) {
    font-size: 16px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .prose-post :global(h2) {
    margin: 32px 0 10px;
    font-size: 19px;
  }
</style>
