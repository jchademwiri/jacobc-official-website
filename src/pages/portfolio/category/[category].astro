---
import Layout from '../../../layouts/Layout.astro';
import ContactBand from '../../../components/ContactBand.astro';
import { getCollection } from 'astro:content';
import { getPortfolioImageUrl } from '../../../lib/images';

const CATEGORIES = {
  tender: {
    label: 'Awarded Tenders',
    heading: 'Awarded municipal & corporate tenders.',
    blurb: 'Compliant, competitive bid submissions prepared end-to-end and awarded multi-year contracts.',
  },
  project: {
    label: 'Project & ISO Delivery',
    heading: 'Contracts & ISO systems delivered.',
    blurb: 'Post-award project coordination, ISO 9001/14001/45001 implementation, and SAP/Sage billing governance.',
  },
  app: {
    label: 'Bid-Tech & Web Apps',
    heading: 'Complementary software & portals.',
    blurb: 'SaaS products and internal portals—from TenderTrack360 bid tracking to client billing systems.',
  },
  website: {
    label: 'Contractor Websites',
    heading: 'Complementary contractor & SME websites.',
    blurb: 'High-performance corporate websites engineered to build procurement credibility and capture leads.',
  },
} as const;

export async function getStaticPaths() {
  const items = await getCollection('portfolio', ({ data }) => !data.draft);
  const categories = [...new Set(items.map((item) => item.data.category))];

  return categories.map((category) => ({
    params: { category },
    props: {
      items: items
        .filter((item) => item.data.category === category)
        .sort((a, b) => b.data.year.localeCompare(a.data.year)),
    },
  }));
}

const { category } = Astro.params;
const { items } = Astro.props;
const meta = CATEGORIES[category as keyof typeof CATEGORIES];

const filters = [
  { key: 'all', label: 'All Work', href: '/portfolio' },
  { key: 'tender', label: 'Awarded Tenders', href: '/portfolio/category/tender' },
  { key: 'project', label: 'Project & ISO Delivery', href: '/portfolio/category/project' },
  { key: 'app', label: 'Bid-Tech & Web Apps', href: '/portfolio/category/app' },
  { key: 'website', label: 'Contractor Websites', href: '/portfolio/category/website' },
];
---

<Layout
  title={`${meta.label} | Portfolio`}
  description={meta.blurb}
  active="portfolio"
  breadcrumb={[
    { name: 'Portfolio', href: '/portfolio' },
    { name: meta.label, href: `/portfolio/category/${category}` },
  ]}
>
  <div class="px-5 pb-6 pt-16 sm:px-8 md:px-14">
    <p class="kicker">{meta.label}</p>
    <h1 class="h1 mt-4 mb-4">{meta.heading}</h1>
    <p class="max-w-[56ch] text-body-lg text-text-2">{meta.blurb}</p>
    <nav class="seg mt-7" aria-label="Filter portfolio by category">
      {
        filters.map((filter) => {
          const isActive = filter.key === category;
          return (
            <a
              href={filter.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={['seg-opt', isActive && 'is-active']}
            >
              {filter.label}
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="grid gap-5 px-5 pb-16 pt-5 sm:px-8 md:grid-cols-2 lg:grid-cols-3 md:px-14">
    {
      items.map((item) => (
        <a href={`/portfolio/${item.id}`} class="card card-interactive group flex flex-col overflow-hidden p-0">
          <img
            src={getPortfolioImageUrl(item.data.cover)}
            alt={`${item.data.title} — ${item.data.client}`}
            width="640"
            height="400"
            class="aspect-[16/10] w-full object-cover"
            loading="lazy"
          />
          <div class="flex flex-1 flex-col px-4 py-4">
            <p class="card-kicker">{meta.label}</p>
            <h2 class="card-title my-2 group-hover:text-accent">{item.data.title}</h2>
            <p class="card-meta mb-2.5">
              {item.data.client} · <span class="data">{item.data.year}</span>
            </p>
            <p class="card-body">{item.data.excerpt}</p>
            {item.data.outcome && <p class="data mt-3 text-meta font-medium text-accent">{item.data.outcome}</p>}
          </div>
        </a>
      ))
    }
  </div>

  <ContactBand secondaryHref="/portfolio" secondaryLabel="← All work" />
</Layout>
