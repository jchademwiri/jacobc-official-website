---
const lifecycleStages = [
  {
    step: '01',
    role: 'PRIMARY ROLE · BID ACQUISITION',
    title: 'Tender Manager',
    desc: 'RFP analysis, CSD/CIDB compliance, competitive pricing & winning municipal/commercial submissions.',
    badge: '5+ 3-Yr Tenders Won',
    accent: true,
  },
  {
    step: '02',
    role: 'COMPLIANCE BACKBONE · APPOINTED REP',
    title: 'ISO 9001 · 14001 · 45001 Lead',
    desc: 'Leading the Integrated Management System (IMS), HIRA registers & DMR 19 compliance that qualify the bid.',
    badge: 'Annex SL IMS',
    accent: true,
  },
  {
    step: '03',
    role: 'EXECUTION & REVENUE · POST-AWARD',
    title: 'Project Delivery & SAP/Sage Billing',
    desc: 'Running awarded contracts on the ground and governing accounts receivable from milestone to cash collection.',
    badge: 'Zero Revenue Leakage',
    accent: true,
  },
  {
    step: '04',
    role: 'COMPLEMENTARY EDGE · DIGITAL SYSTEMS',
    title: 'Web & Bid-Tech Engineering',
    desc: 'Creator of TenderTrack360 SaaS & high-performance Astro/Next.js web platforms for contractors.',
    badge: 'Technical Edge',
    accent: false,
  },
];
---

<aside class="hero-lifecycle-wrap relative" aria-label="Full contract lifecycle capabilities">
  <div class="hero-lifecycle-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative rounded-2xl border border-divider bg-surface/90 p-5 backdrop-blur-[14px] shadow-sm sm:p-6">
    <!-- Top Header -->
    <div class="mb-4 flex items-center justify-between border-b border-divider pb-3.5">
      <div class="flex items-center gap-2">
        <span class="dot" aria-hidden="true"></span>
        <span class="font-mono text-[11px] font-medium uppercase tracking-widest text-accent">
          End-to-End Contract Ownership
        </span>
      </div>
      <span class="data text-label text-text-3">Bid → Delivery → Cash</span>
    </div>

    <!-- Connected Lifecycle Stages -->
    <div class="relative flex flex-col gap-2.5">
      {
        lifecycleStages.map((stage) => (
          <div
            class:list={[
              'rounded-xl border p-3.5 transition-all duration-200',
              stage.accent
                ? 'border-edge bg-bg/75 hover:border-accent/50'
                : 'border-divider/60 bg-bg/45 hover:border-divider',
            ]}
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[10.5px] font-medium uppercase tracking-wider text-accent">
                {stage.step} · {stage.role}
              </span>
              <span
                class:list={[
                  'tag py-0.5 px-2 font-mono text-[10.5px]',
                  stage.accent ? 'tag-accent' : 'tag-neutral',
                ]}
              >
                {stage.badge}
              </span>
            </div>
            <p class="mt-1 text-[14.5px] font-semibold tracking-tight text-text">{stage.title}</p>
            <p class="mt-0.5 text-[12.5px] leading-snug text-text-2">{stage.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Footer Strip -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-divider pt-3 text-label text-text-3">
      <span>Currently at Sithembe Transportation &amp; Projects</span>
      <a href="/resume" class="font-mono text-accent hover:underline">
        View Executive CV →
      </a>
    </div>
  </div>
</aside>

<style>
  .hero-lifecycle-wrap {
    max-width: 490px;
    width: 100%;
    margin-inline: auto;
  }

  .hero-lifecycle-glow {
    background: radial-gradient(320px 260px at 60% 30%, var(--color-section-glow), transparent 75%);
    opacity: 0.45;
  }
</style>
