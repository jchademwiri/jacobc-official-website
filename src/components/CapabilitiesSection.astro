---
import { coreCapabilities, systemsAndStandards } from '../data/siteData';
---

<section id="capabilities" aria-labelledby="capabilities-heading" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">Commercial Depth</p>
      <h2 id="capabilities-heading" class="h2 mt-3">Core Capabilities &amp; Systems</h2>
      <p class="mt-3 text-body-lg text-text-2">
        Hands-on commercial work across technical sourcing, public-sector tenders, live contract administration, ERP invoicing, and ISO/SHEQ compliance.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        coreCapabilities.map((cap, index) => (
          <article class="exec-card flex flex-col justify-between p-6">
            <div>
              <p class="data text-xs font-medium text-accent">
                0{index + 1}
              </p>
              <h3 class="h3 mt-2 text-primary">{cap.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-2">{cap.description}</p>
            </div>

            <div class="mt-5 flex flex-wrap gap-2 border-t border-border/80 pt-4">
              {
                cap.tags.map((tag) => (
                  <span class="pill pill-neutral">{tag}</span>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>

    <!-- Systems & Standards Strip -->
    <div class="mt-8 rounded-xl border border-border bg-surface p-5 sm:p-6">
      <p class="data mb-3 text-[11px] uppercase tracking-widest text-muted">
        ERP Systems, Compliance Frameworks &amp; Standards
      </p>
      <div class="flex flex-wrap gap-2">
        {
          systemsAndStandards.map((item) => (
            <span class="pill pill-bronze px-3 py-1.5 text-xs font-medium">{item}</span>
          ))
        }
      </div>
    </div>
  </div>
</section>
