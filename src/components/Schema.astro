---
import { siteConfig, faqItems } from '../data/siteData';

interface Props {
  site: URL;
  canonical: URL;
  includeFaq?: boolean;
}

const { site, canonical, includeFaq = false } = Astro.props;

const rootUrl = new URL('/', site).href.replace(/\/$/, '');
const personId = `${rootUrl}/#person`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: siteConfig.name,
    jobTitle: siteConfig.title,
    description:
      'Procurement, Tender & Contract Manager in Centurion, South Africa with 5+ years of bid-to-delivery experience across 10+ municipal contracts for the City of Tshwane, City of Ekurhuleni, Pikitup Johannesburg, and Msunduzi Municipality.',
    url: rootUrl,
    email: `mailto:${siteConfig.email}`,
    telephone: '+27-74-049-1433',
    address: {
      '@type': 'PostalAddress',
      addressLocality: siteConfig.locality,
      addressRegion: siteConfig.region,
      addressCountry: siteConfig.country,
    },
    sameAs: [siteConfig.linkedin, siteConfig.website],
    knowsAbout: [
      'Procurement Management',
      'Tender Management',
      'Contract Administration',
      'Public Sector Tendering (MFMA / SCM)',
      'SAP ERP',
      'Sage Accounting',
      'Zoho',
      'ISO 9001',
      'ISO 14001',
      'ISO 45001',
      'SHEQ Governance',
      'CIDB Compliance',
      'Municipal Supply Chain',
      'Plant and Fleet Hire',
    ],
  },
  {
    '@type': 'ProfilePage',
    '@id': `${canonical.href}#profilepage`,
    url: canonical.href,
    name: siteConfig.seo.metaTitle,
    mainEntity: { '@id': personId },
    inLanguage: 'en-ZA',
  },
];

if (includeFaq) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${rootUrl}/#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" is:inline set:html={jsonLd} />
