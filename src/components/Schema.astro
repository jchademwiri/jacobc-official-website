---
import { CONTACT_EMAIL, SOCIAL_PROFILES, SITE_NAME, PERSON_JOB_TITLE, LOCALITY, REGION, COUNTRY } from '../lib/site';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  site: URL;
  canonical: URL;
  kind: 'person' | 'article' | 'service' | 'contact' | 'project' | 'default';
  breadcrumb?: Crumb[];
  headline?: string;
  description?: string;
  image?: URL;
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
}

const { site, canonical, kind, breadcrumb, headline, description, image, publishedTime, updatedTime, tags } =
  Astro.props;

const isHomePage = canonical.pathname === '/' || canonical.pathname === '';
const personId = `${new URL('/', site).href}#person`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: SITE_NAME,
  url: new URL('/', site).href,
  email: `mailto:${CONTACT_EMAIL}`,
  jobTitle: PERSON_JOB_TITLE,
  address: {
    '@type': 'PostalAddress',
    addressLocality: LOCALITY,
    addressRegion: REGION,
    addressCountry: COUNTRY,
  },
  sameAs: SOCIAL_PROFILES,
};

const graph: Record<string, unknown>[] = [person];

// WebSite schema ONLY on homepage
if (isHomePage) {
  graph.push({
    '@type': 'WebSite',
    '@id': `${new URL('/', site).href}#website`,
    name: SITE_NAME,
    url: new URL('/', site).href,
    publisher: { '@id': personId },
  });
}

// LocalBusiness schema for local SEO on relevant pages
if (isHomePage || kind === 'service' || kind === 'contact') {
  graph.push({
    '@type': 'LocalBusiness',
    '@id': `${new URL('/', site).href}#localbusiness`,
    name: SITE_NAME,
    url: new URL('/', site).href,
    description: 'Tender management, project coordination, accounts receivable governance and web development services in Centurion, Gauteng.',
    image: image?.href,
    address: {
      '@type': 'PostalAddress',
      addressLocality: LOCALITY,
      addressRegion: REGION,
      addressCountry: COUNTRY,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: -25.8601,
      longitude: 28.1914,
    },
    sameAs: SOCIAL_PROFILES,
  });
}

if (kind === 'contact') {
  graph.push({
    '@type': 'ContactPage',
    '@id': `${canonical.href}#contactpage`,
    name: `Contact ${SITE_NAME}`,
    url: canonical.href,
    description,
    mainEntity: { '@id': personId },
  });
}

if (kind === 'article' && headline) {
  const modTime = updatedTime ?? publishedTime;
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonical.href}#article`,
    headline,
    description,
    url: canonical.href,
    ...(image && { image: image.href }),
    ...(publishedTime && { datePublished: publishedTime.toISOString() }),
    ...(modTime && { dateModified: modTime.toISOString() }),
    ...(tags?.length && { keywords: tags.join(', ') }),
    author: { '@id': personId },
    publisher: { '@id': personId },
    mainEntityOfPage: canonical.href,
  });
}

if (kind === 'project' && headline) {
  graph.push({
    '@type': 'CreativeWork',
    '@id': `${canonical.href}#project`,
    name: headline,
    headline,
    description,
    url: canonical.href,
    ...(image && { image: image.href }),
    author: { '@id': personId },
    creator: { '@id': personId },
    mainEntityOfPage: canonical.href,
  });
}

if (kind === 'service') {
  graph.push({
    '@type': 'ProfessionalService',
    '@id': `${canonical.href}#service`,
    name: SITE_NAME,
    url: canonical.href,
    description,
    provider: { '@id': personId },
    areaServed: { '@type': 'AdministrativeArea', name: `${REGION}, South Africa` },
    address: {
      '@type': 'PostalAddress',
      addressLocality: LOCALITY,
      addressRegion: REGION,
      addressCountry: COUNTRY,
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Professional & Freelance Services',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Full Tender Preparation Lifecycle',
            description: 'Opportunity identification, RFP review, compliance scheduling, CIDB/CSD validation, and competitive bid compilation.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Website Development',
            description: 'Modern, high-performance web development in React, Next.js, Astro, and Tailwind CSS with ISO-standard quality controls.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Project & AR Governance',
            description: 'Operational delivery coordination, timeline and budget governance, and enterprise billing/credit control in SAP and Sage.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'ISO Standards & SHEQ Compliance',
            description: 'Integrated Management System (ISO 9001, 14001, 45001) gap analysis, SOP formulation, HIRA risk registers, and audit readiness.',
          },
        },
      ],
    },
  });
}

if (breadcrumb?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumb].map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, site).href,
    })),
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" is:inline set:html={jsonLd} />
