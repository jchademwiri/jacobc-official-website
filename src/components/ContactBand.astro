---
import SectionBand from './SectionBand.astro';

interface Props {
  glow?: 'bottom-left' | 'top-right' | 'none';
  /** Set by the host page so the band sits correctly in that page's outline. */
  headingLevel?: 2 | 3;
  heading?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  trustLine?: string;
  id?: string;
}

const {
  glow = 'bottom-left',
  headingLevel = 2,
  heading = 'Ready to talk about your project?',
  body = 'Tell me what you are working on — tender, project or website — and I will come back to you within 24–48 hours.',
  primaryHref = '/contact',
  primaryLabel = 'Start a project',
  secondaryHref = '/services',
  secondaryLabel = 'See what I do',
  trustLine,
  id = 'contact',
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<SectionBand id={id} glow={glow}>
  <Heading class="h2 max-w-[20ch]">{heading}</Heading>
  <p class="mt-3 mb-7 max-w-[52ch] text-body text-text-2">{body}</p>
  <div class="flex flex-col gap-3 sm:flex-row">
    <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
    <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
  </div>
  {trustLine && <p class="data mt-7 text-label text-text-3">{trustLine}</p>}
</SectionBand>
