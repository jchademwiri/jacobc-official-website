---
interface Props {
  variant?: 'default' | 'post';
}

const { variant = 'default' } = Astro.props;
---

{
  variant === 'post' ? (
    <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-divider px-5 py-8 text-sm sm:px-8 md:px-14" style="color: color-mix(in srgb, var(--color-text) 55%, transparent)">
      <a href="/blog" class="text-accent">← All posts</a>
      <a href="mailto:hello@jacobc.co.za" class="btn btn-ghost">hello@jacobc.co.za</a>
    </footer>
  ) : (
    <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-divider px-5 py-8 text-sm sm:px-8 md:px-14" style="color: color-mix(in srgb, var(--color-text) 55%, transparent)">
      <span>© 2026 Jacob Chademwiri</span>
      <div class="flex gap-5">
        <a href="https://github.com/jchademwiri">GitHub</a>
        <a href="https://linkedin.com/in/jchademwiri">LinkedIn</a>
        <a href="mailto:hello@jacobc.co.za">hello@jacobc.co.za</a>
      </div>
    </footer>
  )
}
