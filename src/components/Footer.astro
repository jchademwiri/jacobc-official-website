---
import { siteConfig, navLinks, footerSection } from '../data/siteData';
import { APP_VERSION_LABEL } from '../lib/version';
---

<footer class="no-print border-t border-border bg-surface/60">
  <div class="mx-auto max-w-content px-5 py-10 sm:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-md">
        <p class="text-xs font-semibold tracking-[0.14em] text-primary">{siteConfig.wordmark}</p>
        <p class="mt-2 text-xs leading-relaxed text-text-2">{footerSection.bio}</p>
      </div>

      <nav aria-label="Footer navigation" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-text-2">
        {
          navLinks.map((link) => (
            <a href={link.href} class="transition-colors hover:text-primary">
              {link.label}
            </a>
          ))
        }
        <a
          href="/resume"
          class="transition-colors hover:text-primary"
        >
          Web CV
        </a>
        <a
          href={siteConfig.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-accent"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${siteConfig.email}`}
          class="data transition-colors hover:text-accent"
        >
          {siteConfig.email}
        </a>
      </nav>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5 text-xs text-muted">
      <p>{footerSection.copyright}</p>
      <p class="data flex items-center gap-2">
        <span>{siteConfig.location}</span>
        <span aria-hidden="true">&middot;</span>
        <span title={`Site version ${APP_VERSION_LABEL}`}>{APP_VERSION_LABEL}</span>
      </p>
    </div>
  </div>
</footer>
