---
import { CONTACT_EMAIL, CONTACT_MAILTO, GITHUB_URL, LINKEDIN_URL, SITE_NAME } from '../lib/site';

interface Props {
  variant?: 'default' | 'post' | 'portfolio';
}

const { variant = 'default' } = Astro.props;
const year = new Date().getFullYear();

const backLink = {
  post: { href: '/blog', label: '← All posts' },
  portfolio: { href: '/portfolio', label: '← All work' },
}[variant as 'post' | 'portfolio'];
---

<footer
  class="flex flex-wrap items-center justify-between gap-3 border-t border-divider px-5 py-8 text-meta text-text-3 sm:px-8 md:px-14"
>
  {
    backLink ? (
      <>
        <a href={backLink.href} class="text-accent">
          {backLink.label}
        </a>
        <a href={CONTACT_MAILTO} class="btn btn-ghost">
          {CONTACT_EMAIL}
        </a>
      </>
    ) : (
      <>
        <span>© <span class="data">{year}</span> {SITE_NAME}</span>
        <div class="flex flex-wrap gap-5">
          <a href={GITHUB_URL} class="hover:text-text">GitHub</a>
          <a href={LINKEDIN_URL} class="hover:text-text">LinkedIn</a>
          <a href="/rss.xml" class="hover:text-text">RSS</a>
          <a href={CONTACT_MAILTO} class="hover:text-text">{CONTACT_EMAIL}</a>
        </div>
      </>
    )
  }
</footer>
