---
import { faqItems } from '../data/siteData';
---

<section id="faq" aria-labelledby="faq-heading" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">Quick Answers for Recruiters &amp; Hiring Teams</p>
      <h2 id="faq-heading" class="h2 mt-3">Frequently Asked Questions</h2>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        faqItems.map((item) => (
          <article class="exec-card p-6">
            <h3 class="text-base font-semibold leading-snug text-primary">{item.question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-2">{item.answer}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
