---
import { experienceTimeline, credentialsList } from '../data/siteData';
---

<section id="experience" aria-labelledby="experience-heading" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">Career Progression</p>
      <h2 id="experience-heading" class="h2 mt-3">Experience &amp; Credentials</h2>
      <p class="mt-3 text-body-lg text-text-2">
        Progressive internal promotion from Tendering Administrator to Tender, Procurement &amp; Contract Manager, underpinned by analytical systems discipline.
      </p>
    </div>

    <!-- Career Timeline -->
    <div class="mt-10 space-y-6">
      {
        experienceTimeline.map((company, companyIdx) => (
          <article class="exec-card p-6 sm:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-4">
              <div>
                <h3 class="text-lg font-semibold tracking-tight text-primary">{company.company}</h3>
                <p class="data mt-0.5 text-xs text-muted">{company.location}</p>
              </div>
              {companyIdx === 0 && (
                <span class="pill pill-bronze">Current Organization</span>
              )}
            </div>

            <div class:list={['mt-5 space-y-6', company.roles.length > 1 && 'relative ml-2 border-l border-border pl-6']}>
              {
                company.roles.map((role, roleIdx) => (
                  <div class="relative">
                    {company.roles.length > 1 && (
                      <span
                        class:list={[
                          'absolute -left-[29px] top-1.5 h-2.5 w-2.5 rounded-full border-2',
                          roleIdx === 0
                            ? 'border-accent bg-accent'
                            : 'border-border bg-surface-2',
                        ]}
                        aria-hidden="true"
                      />
                    )}
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <h4 class="text-base font-semibold text-primary">{role.title}</h4>
                      <span class="data text-xs font-medium text-accent">{role.period}</span>
                    </div>

                    <ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-2">
                      {
                        role.highlights.map((hl) => (
                          <li class="flex items-start gap-2.5">
                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/80" aria-hidden="true"></span>
                            <span>{hl}</span>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>

    <!-- Education & Credentials Strip -->
    <div class="mt-10">
      <h3 class="data mb-4 text-xs font-medium uppercase tracking-widest text-accent">
        Education, Certifications &amp; Credentials
      </h3>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          credentialsList.map((cred) => (
            <div class="exec-card p-5">
              <p class="text-sm font-semibold text-primary">{cred.title}</p>
              <p class="data mt-1 text-xs text-muted">{cred.issuer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
