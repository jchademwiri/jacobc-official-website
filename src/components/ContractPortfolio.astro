---
import {
  contractCategories,
  municipalEntities,
  contractPortfolio,
} from '../data/siteData';

const totalContracts = contractPortfolio.length;
---

<section id="track-record" aria-labelledby="track-record-heading" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow">Verified Track Record</p>
      <h2 id="track-record-heading" class="h2 mt-3">Municipal Contract Portfolio</h2>
      <p class="mt-3 text-body-lg text-text-2">
        A selection of multi-year public-sector contracts I have priced, won, inherited, and managed for the City of Tshwane, City of Ekurhuleni, Pikitup Johannesburg, and Msunduzi Municipality.
      </p>
    </div>

    <!-- Dual Filter Bar -->
    <div class="no-print mt-8 flex flex-col gap-4 rounded-xl border border-border bg-surface/70 p-4 sm:p-5">
      <div>
        <p class="data mb-2 text-[11px] uppercase tracking-widest text-muted">Filter by Category</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter contracts by category">
          {
            contractCategories.map((cat) => {
              const count =
                cat === 'All'
                  ? totalContracts
                  : contractPortfolio.filter((c) => c.category === cat).length;
              return (
                <button
                  type="button"
                  data-filter-category={cat}
                  aria-pressed={cat === 'All' ? 'true' : 'false'}
                  class:list={['filter-pill', cat === 'All' && 'is-active']}
                >
                  <span>{cat}</span>
                  <span class="data text-[11px] opacity-75">({count})</span>
                </button>
              );
            })
          }
        </div>
      </div>

      <div class="flex flex-col gap-3 border-t border-border pt-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="data mb-2 text-[11px] uppercase tracking-widest text-muted">Filter by Municipal Entity</p>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter contracts by municipal entity">
            {
              municipalEntities.map((entity) => (
                <button
                  type="button"
                  data-filter-entity={entity}
                  aria-pressed={entity === 'All Entities' ? 'true' : 'false'}
                  class:list={['filter-pill', entity === 'All Entities' && 'is-active']}
                >
                  {entity}
                </button>
              ))
            }
          </div>
        </div>

        <p
          id="contract-count"
          aria-live="polite"
          class="data shrink-0 self-start text-xs text-muted sm:self-end"
        >
          Showing {totalContracts} of {totalContracts} contracts
        </p>
      </div>
    </div>

    <!-- Contract Grid -->
    <div id="contract-grid" class="mt-8 grid gap-5 md:grid-cols-2">
      {
        contractPortfolio.map((item) => (
          <article
            class="contract-card flex flex-col justify-between p-5 sm:p-6"
            data-contract-card
            data-category={item.category}
            data-entity={item.entity}
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="data text-sm font-semibold tracking-tight text-accent">
                  {item.ref}
                </span>
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="pill pill-bronze">{item.status}</span>
                  <span class="pill pill-neutral">{item.role}</span>
                </div>
              </div>

              <h3 class="h3 mt-2.5 text-primary">{item.title}</h3>

              <p class="data mt-1.5 text-xs text-muted">
                {item.entity} &middot; {item.period}
              </p>

              <p class="mt-3 text-sm leading-relaxed text-text-2">{item.summary}</p>

              <ul class="mt-4 space-y-1.5 border-t border-border/80 pt-3.5 text-xs leading-relaxed text-text-2">
                {
                  item.highlights.map((hl) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                      <span>{hl}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="mt-4 pt-2">
              <span class="data text-[11px] uppercase tracking-wider text-muted">
                {item.category}
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Empty State -->
    <div
      id="contract-empty"
      hidden
      class="mt-8 rounded-xl border border-border bg-surface p-8 text-center"
    >
      <p class="text-base font-medium text-primary">
        No contracts match that category and municipality combination.
      </p>
      <p class="mt-1 text-sm text-text-2">
        Reset the filters to view all {totalContracts} verified municipal contracts.
      </p>
      <button type="button" id="reset-contract-filters" class="btn btn-secondary mt-4 text-xs">
        Reset Filters
      </button>
    </div>
  </div>
</section>

<script>
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-category]');
  const entityBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-entity]');
  const cards = document.querySelectorAll<HTMLElement>('[data-contract-card]');
  const countEl = document.getElementById('contract-count');
  const emptyEl = document.getElementById('contract-empty');
  const resetBtn = document.getElementById('reset-contract-filters');

  let activeCategory = 'All';
  let activeEntity = 'All Entities';
  const total = cards.length;

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const catMatch = activeCategory === 'All' || card.dataset.category === activeCategory;
      const entityMatch = activeEntity === 'All Entities' || card.dataset.entity === activeEntity;
      const show = catMatch && entityMatch;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (countEl) {
      countEl.textContent = `Showing ${visible} of ${total} contracts`;
    }
    if (emptyEl) {
      emptyEl.hidden = visible > 0;
    }

    categoryBtns.forEach((btn) => {
      const active = btn.dataset.filterCategory === activeCategory;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    entityBtns.forEach((btn) => {
      const active = btn.dataset.filterEntity === activeEntity;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filterCategory || 'All';
      applyFilters();
    });
  });

  entityBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeEntity = btn.dataset.filterEntity || 'All Entities';
      applyFilters();
    });
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'All';
    activeEntity = 'All Entities';
    applyFilters();
  });
</script>
