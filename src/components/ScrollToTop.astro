---
---

<button
  type="button"
  id="scroll-to-top"
  aria-label="Scroll to top"
  aria-hidden="true"
  tabindex="-1"
  class="fixed bottom-24 right-5 z-30 flex h-12 w-12 items-center justify-center rounded-full bg-surface opacity-0 shadow-lg transition-opacity duration-200 pointer-events-none"
  style="box-shadow: var(--shadow-sm), 0 4px 12px rgba(0, 0, 0, 0.3);"
>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  const button = document.getElementById('scroll-to-top');

  if (button) {
    const toggleVisibility = () => {
      const show = window.scrollY > window.innerHeight;
      button.classList.toggle('opacity-0', !show);
      button.classList.toggle('pointer-events-none', !show);
      button.setAttribute('aria-hidden', String(!show));
      button.tabIndex = show ? 0 : -1;
    };

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: prefersReducedMotion.matches ? 'auto' : 'smooth' });
    });
  }
</script>
