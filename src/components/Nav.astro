---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig, navLinks } from '../data/siteData';
---

<header class="no-print sticky top-0 z-40 border-b border-border bg-bg/92 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-5 sm:px-8">
    <!-- Brand Wordmark -->
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-semibold tracking-[0.14em] text-primary transition-colors hover:text-accent"
    >
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      <span>{siteConfig.wordmark}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary navigation" class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-text-2 transition-colors hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2.5">
      <ThemeToggle />

      <a
        href={siteConfig.cvPath}
        download
        class="btn btn-primary hidden min-h-[38px] px-4 py-2 text-xs sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download CV</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-border bg-surface text-primary md:hidden"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="border-t border-border bg-bg px-5 py-4 md:hidden"
  >
    <nav aria-label="Mobile navigation" class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-mobile-link
            class="rounded-md px-2 py-2 text-sm font-medium text-text-2 transition-colors hover:bg-surface hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-2 flex flex-col gap-2 border-t border-border pt-3">
        <a
          href={siteConfig.cvPath}
          download
          class="btn btn-primary w-full justify-center text-xs"
        >
          Download CV (PDF)
        </a>
        <a
          href="/resume"
          class="btn btn-secondary w-full justify-center text-xs"
        >
          View Web CV
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    const closeDrawer = () => {
      drawer.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    };

    toggleBtn.addEventListener('click', () => {
      const isOpening = drawer.hidden;
      drawer.hidden = !isOpening;
      toggleBtn.setAttribute('aria-expanded', isOpening ? 'true' : 'false');
    });

    drawer.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) {
        closeDrawer();
        toggleBtn.focus();
      }
    });
  }
</script>
