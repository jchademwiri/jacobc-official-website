---
interface Props {
  active?: 'home' | 'services' | 'portfolio' | 'blog' | 'about' | 'contact';
}

const { active } = Astro.props;

const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/services', label: 'Services', key: 'services' },
  { href: '/portfolio', label: 'Portfolio', key: 'portfolio' },
  { href: '/blog', label: 'Blog', key: 'blog' },
  { href: '/about', label: 'About', key: 'about' },
];
---

<header
  class="sticky top-0 z-20 w-full border-b border-divider backdrop-blur-[14px] print:hidden"
  style="background: color-mix(in srgb, var(--color-bg) 75%, transparent)"
>
  <nav
    class="mx-auto flex items-center justify-between max-w-content px-5 py-3.5 sm:px-8 md:px-14 relative w-full"
    aria-label="Primary navigation"
  >
    <!-- Brand / Logo -->
    <a href="/" class="group flex items-center gap-2.5 text-base font-medium transition-colors">
      <img
        src="/images/logos/logo-mark.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 rounded-lg shadow-xs transition-transform duration-200 group-hover:scale-105"
      />
      <span class="font-medium tracking-tight text-text transition-colors duration-200 group-hover:text-accent">
        <span class="hidden sm:inline">Jacob Chademwiri</span>
        <span class="sm:hidden">Jacob C.</span>
      </span>
    </a>

    <!-- Center-docked floating pill nav -->
    <div class="hidden items-center gap-1 rounded-full border border-divider/60 bg-surface/50 p-1 backdrop-blur-md shadow-xs md:flex md:absolute md:left-1/2 md:-translate-x-1/2">
      {
        links.map((link) => {
          const isActive = active === link.key;
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-full px-3.5 py-1 text-[13.5px] font-medium transition-all duration-200',
                isActive
                  ? 'bg-accent/14 text-accent font-semibold shadow-xs'
                  : 'text-text-2 hover:bg-white/5 hover:text-text',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>

    <!-- Right: CTA Button & Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class:list={[
          'group btn btn-primary hidden shrink-0 items-center gap-1.5 whitespace-nowrap text-[13.5px] md:inline-flex',
          active === 'contact' && 'is-current',
        ]}
        aria-current={active === 'contact' ? 'page' : undefined}
      >
        <span>Start a project</span>
        <span class="text-xs transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        id="nav-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        class="group -mr-1.5 flex h-11 w-11 flex-col items-center justify-center gap-[5px] rounded-lg border border-transparent hover:border-divider/60 hover:bg-surface/40 md:hidden"
      >
        <span class="block h-[2px] w-[20px] bg-text transition-all duration-200 group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
        <span class="block h-[2px] w-[20px] bg-text transition-all duration-200 group-aria-expanded:opacity-0"></span>
        <span class="block h-[2px] w-[20px] bg-text transition-all duration-200 group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div
    id="nav-mobile-menu"
    hidden
    class="border-b border-divider px-6 pb-6 pt-4 backdrop-blur-[16px] md:hidden shadow-lg w-full"
    style="background: color-mix(in srgb, var(--color-bg) 95%, transparent)"
  >
    <div class="mx-auto max-w-content flex flex-col gap-1.5">
      {
        links.map((link) => {
          const isActive = active === link.key;
          return (
            <a
              href={link.href}
              class:list={[
                'flex items-center justify-between rounded-lg px-3.5 py-2.5 text-base font-medium transition-colors',
                isActive
                  ? 'bg-accent/12 text-accent font-semibold'
                  : 'text-text-2 hover:bg-white/5 hover:text-text',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              <span>{link.label}</span>
              {isActive && <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>}
            </a>
          );
        })
      }
      <div class="mt-2 border-t border-divider pt-3.5">
        <a href="/contact" class="btn btn-primary flex w-full items-center justify-center gap-1.5 py-2.5">
          <span>Start a project</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-menu-toggle');
  const menu = document.getElementById('nav-mobile-menu');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    };

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });

    // Close if viewport expands to desktop nav breakpoint
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900 && !menu.hidden) {
        closeMenu();
      }
    });
  }
</script>
