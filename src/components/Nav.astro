---
import ThemeToggle from './ThemeToggle.astro';
import CvDownloadButton from './CvDownloadButton.astro';
import { siteConfig, navLinks } from '../data/siteData';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isRouteActive(href: string): boolean {
  if (href.startsWith('/#')) return false;
  return currentPath === href;
}

function getSectionId(href: string): string | undefined {
  if (href === '/track-record') return 'track-record';
  if (href.startsWith('/#')) return href.slice(2);
  return undefined;
}
---

<header class="no-print sticky top-0 z-40 border-b border-border bg-bg/92 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-5 sm:px-8">
    <!-- Brand Wordmark -->
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-semibold tracking-[0.14em] text-primary transition-colors hover:text-accent"
    >
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      <span>{siteConfig.wordmark}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary navigation" class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => {
          const active = isRouteActive(link.href);
          const sectionId = getSectionId(link.href);
          return (
            <a
              href={link.href}
              data-nav-link
              data-section-id={sectionId}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'nav-link relative py-1 text-sm font-medium text-text-2 transition-colors hover:text-primary',
                active && 'is-active',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2.5">
      <ThemeToggle />

      <CvDownloadButton
        label="Download CV"
        disabledLabel="CV Updating"
        showIcon={true}
        iconSize={14}
        class="hidden min-h-[38px] px-4 py-2 text-xs sm:inline-flex"
      />

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-border bg-surface text-primary md:hidden"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="border-t border-border bg-bg px-5 py-4 md:hidden"
  >
    <nav aria-label="Mobile navigation" class="flex flex-col gap-1.5">
      {
        navLinks.map((link) => {
          const active = isRouteActive(link.href);
          const sectionId = getSectionId(link.href);
          return (
            <a
              href={link.href}
              data-mobile-link
              data-section-id={sectionId}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'mobile-nav-link rounded-md px-3 py-2 text-sm font-medium text-text-2 transition-colors hover:bg-surface hover:text-primary',
                active && 'is-active',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <div class="mt-2 flex flex-col gap-2 border-t border-border pt-3">
        <CvDownloadButton label="Download CV (DOCX)" class="w-full justify-center text-xs" />
        <a
          href="/resume"
          class="btn btn-secondary w-full justify-center text-xs"
        >
          View Web CV
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease;
  }

  .nav-link.is-active {
    color: var(--color-primary);
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .mobile-nav-link.is-active {
    background: var(--color-surface);
    color: var(--color-primary);
    border-left: 2px solid var(--color-accent);
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    const closeDrawer = () => {
      drawer.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    };

    toggleBtn.addEventListener('click', () => {
      const isOpening = drawer.hidden;
      drawer.hidden = !isOpening;
      toggleBtn.setAttribute('aria-expanded', isOpening ? 'true' : 'false');
    });

    drawer.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) {
        closeDrawer();
        toggleBtn.focus();
      }
    });
  }

  // Scroll-spy for home page sections
  const pathname = window.location.pathname.replace(/\/+$/, '') || '/';
  if (pathname === '/') {
    const sectionIds = ['track-record', 'capabilities', 'experience', 'faq', 'contact'];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    const navItems = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-mobile-link]');

    const setActiveSection = (activeId: string | null) => {
      navItems.forEach((link) => {
        const match = activeId !== null && link.dataset.sectionId === activeId;
        link.classList.toggle('is-active', match);
        if (match) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    if (sections.length > 0) {
      const updateActiveOnScroll = () => {
        const scrollY = window.scrollY;
        const viewportH = window.innerHeight;
        const docH = document.documentElement.scrollHeight;

        // Near very top (Hero): clear section indicator
        if (scrollY < 160) {
          setActiveSection(null);
          return;
        }

        // Near bottom of page: highlight Contact
        if (scrollY + viewportH >= docH - 60) {
          setActiveSection('contact');
          return;
        }

        // Pick the last section whose top has passed the sticky nav + 120px trigger line
        const triggerY = scrollY + 140;
        let current: string | null = null;
        for (const sec of sections) {
          if (sec.offsetTop <= triggerY) {
            current = sec.id;
          }
        }
        setActiveSection(current);
      };

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateActiveOnScroll();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true }
      );

      window.addEventListener('hashchange', updateActiveOnScroll);
      updateActiveOnScroll();
    }
  }
</script>
