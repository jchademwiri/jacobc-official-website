# Contact form delivery (https://resend.com).
#
# The sending domain verified in Resend is `info.jacobc.co.za`. Only the From
# address has to live on it — messages are delivered to hello@jacobc.co.za and
# reply-to is set to whoever filled in the form.
#
# Required for /contact to send. Without it the form returns its failure state
# and points visitors at the mailto address instead.
RESEND_API_KEY=

# Optional. Overrides the From address, which defaults to
# noreply@info.jacobc.co.za. Must be on the verified sending domain or Resend
# will reject the message.
CONTACT_FROM_EMAIL=

# Optional. The brand half of the From display name, which is built as
# "{sender's name} via {SENDER_NAME}" — so a submission from Thabo Mokoena
# arrives as "Thabo Mokoena via Jacob C". Defaults to "Jacob Chademwiri".
SENDER_NAME=
