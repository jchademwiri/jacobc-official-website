{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/#experience", "permanent": true },
    { "source": "/services", "destination": "/#capabilities", "permanent": true },
    { "source": "/services/:slug*", "destination": "/#capabilities", "permanent": true },
    { "source": "/portfolio", "destination": "/track-record", "permanent": true },
    { "source": "/portfolio/:slug*", "destination": "/track-record", "permanent": true },
    { "source": "/blog", "destination": "/#faq", "permanent": true },
    { "source": "/blog/:slug*", "destination": "/#faq", "permanent": true },
    { "source": "/experience/:slug*", "destination": "/#experience", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/resume-v1", "destination": "/resume", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://vitals.vercel-insights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
